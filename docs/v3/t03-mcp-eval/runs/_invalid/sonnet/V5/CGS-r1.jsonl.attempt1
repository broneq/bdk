{"type":"system","subtype":"init","cwd":"/private/tmp/claude-502/-Users-przemyslawbroniszewski-projects-bdk/44b8e8a6-73c2-4568-9584-0db12ea9805b/scratchpad/bench/wt/CGS","session_id":"99fdf38d-a07a-4aa9-9b5d-c35658aad665","tools":["Task","Bash","CronCreate","CronDelete","CronList","DesignSync","Edit","EnterWorktree","ExitWorktree","ListAgents","ListMcpResourcesTool","Monitor","NotebookEdit","PushNotification","Read","ReadMcpResourceDirTool","ReadMcpResourceTool","RemoteTrigger","ReportFindings","ScheduleWakeup","SendMessage","ShareOnboardingGuide","Skill","TaskStop","ToolSearch","WebFetch","WebSearch","Workflow","Write","mcp__plugin_bdk_serena__find_declaration","mcp__plugin_bdk_serena__find_implementations","mcp__plugin_bdk_serena__find_referencing_symbols","mcp__plugin_bdk_serena__find_symbol","mcp__plugin_bdk_serena__get_diagnostics_for_file","mcp__plugin_bdk_serena__get_symbols_overview","mcp__plugin_bdk_serena__initial_instructions","mcp__plugin_bdk_serena__insert_after_symbol","mcp__plugin_bdk_serena__insert_before_symbol","mcp__plugin_bdk_serena__open_dashboard","mcp__plugin_bdk_serena__rename_symbol","mcp__plugin_bdk_serena__replace_content","mcp__plugin_bdk_serena__replace_in_files","mcp__plugin_bdk_serena__replace_symbol_body","mcp__plugin_bdk_serena__safe_delete_symbol"],"mcp_servers":[{"name":"plugin:bdk:code-review-graph","status":"failed","source":"plugin"},{"name":"plugin:bdk:serena","status":"connected","source":"plugin"}],"model":"claude-sonnet-5","permissionMode":"default","slash_commands":["deep-research","bdk:add-rule","bdk:commit","bdk:cr","bdk:create-adr","bdk:create-plan","bdk:debug","bdk:design","bdk:explain-complex-code","bdk:mermaid-drawer","bdk:pr-review","bdk:refine-rules","bdk:setup","bdk:subagent-execute-plan","bdk:test-driven-development","bdk:update-docs","bdk:verify-plan","design","design-sync","dataviz","update-config","verify","debug","code-review","simplify","batch","fewer-permission-prompts","doctor","loop","schedule","claude-api
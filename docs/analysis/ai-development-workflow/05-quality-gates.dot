digraph quality_gates {
    rankdir=LR
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    subgraph cluster_realtime {
        label="Real-time (every .py edit)" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#E3F2FD" color="#90CAF9"
        node [fillcolor="#BBDEFB" color="#1976D2"]

        rt_ruff [label="ruff format\n+ check --fix"]
        rt_mypy [label="mypy .\n(advisory)"]
        rt_codegraph [label="codegraph\nmark-dirty"]
    }

    subgraph cluster_pretool {
        label="Pre-edit Guard" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#FFEBEE" color="#EF9A9A"
        node [fillcolor="#FFCDD2" color="#D32F2F" shape=octagon]

        guard [label="BLOCK .env*\nBLOCK secrets/*"]
    }

    subgraph cluster_session_end {
        label="Session End" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#FFF3E0" color="#FFB74D"
        node [fillcolor="#FFE0B2" color="#F57C00"]

        drift [label="Rules Drift\nDetection" shape=octagon]
        reminder [label="Test Reminder"]
        cg_sync [label="CodeGraph\nSync"]
    }

    subgraph cluster_precommit {
        label="Pre-commit (bin/cleanup.sh)" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#F3E5F5" color="#CE93D8"
        node [fillcolor="#E1BEE7" color="#7B1FA2"]

        pc_ruff_check [label="ruff check"]
        pc_ruff_fmt [label="ruff format"]
        pc_mypy [label="mypy strict"]
        pc_radon_src [label="radon MI/CC\nsrc/ (A-grade)"]
        pc_radon_test [label="radon MI/CC\ntests/"]
        pc_actionlint [label="actionlint\nCI workflows"]
    }

    subgraph cluster_review {
        label="Code Review (/cr)" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#E8F5E9" color="#A5D6A7"
        node [fillcolor="#C8E6C9" color="#388E3C"]

        cr_code [label="Code Review\n(per layer)"]
        cr_arch [label="Architecture\nReview"]
        cr_dead [label="Dead Code\nDetection"]
        cr_dup [label="Duplicate\nDetection"]
        cr_tests [label="Test Review"]
    }

    // Flow
    guard -> rt_ruff [label="edit allowed" color="#388E3C"]
    rt_ruff -> rt_mypy
    rt_mypy -> rt_codegraph

    rt_codegraph -> drift [label="session end" style=dashed]
    drift -> reminder -> cg_sync

    cg_sync -> pc_ruff_check [label="pre-commit" style=dashed]
    pc_ruff_check -> pc_ruff_fmt -> pc_mypy -> pc_radon_src -> pc_radon_test -> pc_actionlint

    pc_actionlint -> cr_code [label="/cr" style=dashed]
    cr_code -> cr_arch [style=invis]
    cr_arch -> cr_dead [style=invis]
    cr_dead -> cr_dup [style=invis]
    cr_dup -> cr_tests [style=invis]
}

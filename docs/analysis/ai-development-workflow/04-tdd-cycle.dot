digraph tdd_cycle {
    rankdir=TB
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    subgraph cluster_tdd {
        label="TDD Cycle (per task)" labeljust=l fontsize=12 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#FAFAFA" color="#E0E0E0"

        node [fillcolor="#FFCDD2" color="#D32F2F"]
        gate0 [label="Gate 0: Load Context\nSerena memories:\ntest-assertion-helpers\nintegration_test_fixtures"]

        node [fillcolor="#FFCDD2" color="#D32F2F"]
        gate1 [label="Gate 1: Write Tests\nAll test cases from plan\n+ gap-scan boundaries"]

        node [fillcolor="#EF9A9A" color="#C62828"]
        gate2 [label="Gate 2: Verify RED\nAll tests MUST fail\n(test-runner agent)" shape=octagon]

        node [fillcolor="#C8E6C9" color="#388E3C"]
        gate3 [label="Gate 3: Implement\nMinimal code to pass\nNo extra features"]

        node [fillcolor="#A5D6A7" color="#2E7D32"]
        gate4 [label="Gate 4: Verify GREEN\nAll tests MUST pass\n(test-runner agent)" shape=octagon]

        node [fillcolor="#E1BEE7" color="#7B1FA2"]
        post [label="Post: Update Memories\nNew helpers/factories"]
    }

    gate0 -> gate1 [penwidth=2]
    gate1 -> gate2 [penwidth=2]
    gate2 -> gate3 [label="all FAIL" penwidth=2 color="#388E3C"]
    gate2 -> gate1 [label="some PASS\ninvestigate" style=dashed color="#D32F2F"]
    gate3 -> gate4 [penwidth=2]
    gate4 -> post [label="all PASS" penwidth=2 color="#388E3C"]
    gate4 -> gate3 [label="failures\n(max 3x)" style=dashed color="#D32F2F"]
}

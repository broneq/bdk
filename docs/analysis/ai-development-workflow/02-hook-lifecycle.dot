digraph hook_lifecycle {
    rankdir=TB
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    // Session lifecycle
    subgraph cluster_session {
        label="Session Lifecycle" labeljust=l fontsize=12 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#F5F5F5" color="#BDBDBD"

        node [fillcolor="#C8E6C9" color="#388E3C"]
        session_start [label="SessionStart"]

        node [fillcolor="#E3F2FD" color="#1976D2"]
        work [label="Development Work\n(edit, write, test...)" shape=ellipse]

        node [fillcolor="#FFCDD2" color="#D32F2F"]
        session_stop [label="Stop"]
    }

    // SessionStart hooks
    subgraph cluster_start_hooks {
        label="SessionStart Hooks" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#E8F5E9" color="#81C784"
        node [fillcolor="#FFFFFF" color="#388E3C" fontsize=9]

        start_git [label="git status -s\n(orientation)"]
        start_dirs [label="ensure-directories.sh\n(docs/cr, plans, progress)"]
        start_drift [label="check_rules_drift.py\n--snapshot-baseline\n(record pre-existing changes)"]
    }

    // PreToolUse hooks
    subgraph cluster_pre {
        label="PreToolUse (Edit/Write)" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#FFF8E1" color="#FFB300"
        node [fillcolor="#FFFFFF" color="#FF8F00" fontsize=9]

        pre_sensitive [label="Sensitive File Guard\nBlocks: *.env*, secrets/*" shape=octagon]
    }

    // PostToolUse hooks
    subgraph cluster_post {
        label="PostToolUse (Edit/Write)" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#E3F2FD" color="#64B5F6"
        node [fillcolor="#FFFFFF" color="#1976D2" fontsize=9]

        post_ruff [label="ruff format\n+ ruff check --fix"]
        post_mypy [label="mypy .\n(first 20 lines)"]
        post_codegraph [label="codegraph mark-dirty\n(async)"]
    }

    // Stop hooks
    subgraph cluster_stop_hooks {
        label="Stop Hooks" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#FFEBEE" color="#EF9A9A"
        node [fillcolor="#FFFFFF" color="#D32F2F" fontsize=9]

        stop_reminder [label="Reminder:\nRun tests?\nRuff check?"]
        stop_drift [label="check_rules_drift.py\nBLOCKS if rules\nout of sync" shape=octagon]
        stop_codegraph [label="codegraph sync-if-dirty"]
    }

    // WorktreeCreate
    subgraph cluster_worktree {
        label="WorktreeCreate" labeljust=l fontsize=10
        style="rounded,filled" fillcolor="#F3E5F5" color="#CE93D8"
        node [fillcolor="#FFFFFF" color="#7B1FA2" fontsize=9]

        wt_setup [label="setup-worktree.py\ngit worktree + uv venv\n+ pip install -e .[dev]"]
    }

    // Flow
    session_start -> start_git -> start_dirs -> start_drift [color="#388E3C"]
    start_drift -> work [color="#388E3C"]

    work -> pre_sensitive [label="before edit" color="#FF8F00"]
    pre_sensitive -> work [label="allowed" color="#388E3C" style=dashed]

    work -> post_ruff [label="after edit" color="#1976D2"]
    post_ruff -> post_mypy [color="#1976D2"]
    work -> post_codegraph [label="async" style=dashed color="#90CAF9"]

    work -> session_stop [color="#D32F2F"]
    session_stop -> stop_reminder -> stop_drift -> stop_codegraph [color="#D32F2F"]
    stop_drift -> work [label="BLOCKED\nupdate rules" color="#D32F2F" style=dashed penwidth=2]
}

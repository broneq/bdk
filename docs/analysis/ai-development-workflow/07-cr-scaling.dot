digraph cr_scaling {
    rankdir=TB
    bgcolor="white"
    node [fontname="Helvetica" fontsize=11 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=9 color="#333333"]

    // Entry
    node [fillcolor="#263238" color="#263238" fontcolor="white" fontsize=12]
    entry [label="/cr"]

    // Size detection
    node [fillcolor="#F57F17" color="#E65100" fontcolor="white"]
    detect [label="git diff --stat\nClassify by layer\nCount changed lines"]

    entry -> detect [penwidth=2]

    // Tiers
    node [fillcolor="#2E7D32" color="#1B5E20" fontcolor="white"]
    tiny [label="TINY\n< 50 lines\n4 agents"]

    node [fillcolor="#F9A825" color="#E65100" fontcolor="#212121"]
    small [label="SMALL\n50–1000 lines\n7 agents"]

    node [fillcolor="#E64A19" color="#BF360C" fontcolor="white"]
    large [label="LARGE\n1000–3000 lines\n2N+5 agents"]

    node [fillcolor="#B71C1C" color="#7F0000" fontcolor="white"]
    massive [label="MASSIVE\n3000+ lines\nup to 15 agents"]

    detect -> tiny   [label="< 50"       fontcolor="#2E7D32" color="#2E7D32"]
    detect -> small  [label="50–1000"    fontcolor="#F9A825" color="#E65100"]
    detect -> large  [label="1000–3000"  fontcolor="#E64A19" color="#E64A19"]
    detect -> massive[label="3000+"      fontcolor="#B71C1C" color="#B71C1C"]

    // Agent breakdown boxes — dark fill, white text
    node [fillcolor="#1565C0" color="#0D47A1" fontcolor="white" fontsize=10]

    tiny_agents [label="layer-group (1)\ntest-reviewer (1)\nstatic-analyse (1)\ntest-runner (1)"]
    small_agents [label="layer-group (1)\ntest-reviewer (1)\narchitecture-reviewer (1)\nduplicate-detector (1)\ndead-code-detector (1)\nstatic-analyse (1)\ntest-runner (1)"]
    large_agents [label="layer-group (N)\ntest-reviewer (1)\narchitecture-reviewer (1)\nduplicate-detector (1)\ndead-code-detector (1)\nstatic-analyse (1)\ntest-runner (1)"]

    tiny    -> tiny_agents   [style=dashed color="#1565C0"]
    small   -> small_agents  [style=dashed color="#1565C0"]
    large   -> large_agents  [style=dashed color="#1565C0"]
    massive -> large_agents  [label="partitioned\nlayer groups" style=dashed color="#1565C0"]

    // Output
    node [fillcolor="#6A1B9A" color="#4A148C" fontcolor="white" fontsize=11]
    report [label="14-Section\nMarkdown Report"]

    tiny_agents   -> report [style=dashed color="#6A1B9A" penwidth=1.5]
    small_agents  -> report [style=dashed color="#6A1B9A" penwidth=1.5]
    large_agents  -> report [style=dashed color="#6A1B9A" penwidth=1.5]
}

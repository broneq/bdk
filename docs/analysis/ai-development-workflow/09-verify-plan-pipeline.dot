digraph verify_plan {
    rankdir=LR
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    // Input
    node [fillcolor="#37474F" color="#263238" fontcolor="white"]
    input [label="Plan File\n(docs/plans/*.md)"]

    // Stage 1
    node [fillcolor="#66BB6A" color="#2E7D32" fontcolor="white"]
    stage1 [label="Stage 1: Explorer\n(Haiku)\nGather signatures,\ntypes, callers"]

    // Stage 2 - parallel
    node [fillcolor="#FF7043" color="#BF360C" fontcolor="white"]
    stage2a [label="Stage 2A: Plan Prover\n(Opus step-simulator)\nTrace target scenario\nwith concrete data"]
    stage2b [label="Stage 2B: Regression Hunter\n(Opus step-simulator)\nTrace OTHER flows\n(nype46, gencon1994...)"]

    // Stage 3
    node [fillcolor="#42A5F5" color="#1565C0" fontcolor="white"]
    stage3 [label="Stage 3: Code Reviewer\n(Sonnet)\nReview proposed code\nvs patterns"]

    // Verdict
    node [fillcolor="#C8E6C9" color="#388E3C"]
    pass [label="PASS\nProceed to\n/execute-plan"]

    node [fillcolor="#FFCDD2" color="#D32F2F"]
    fail [label="FAIL\nRetry (max 3x)\nthen suggest\n/brainstorming"]

    // Flow
    input -> stage1 [penwidth=2]
    stage1 -> stage2a [penwidth=2]
    stage1 -> stage2b [penwidth=2]

    // Parallel indicator
    {rank=same; stage2a; stage2b}

    stage2a -> stage3 [penwidth=2]
    stage2b -> stage3 [penwidth=2]

    stage3 -> pass [label="all clear" color="#388E3C" penwidth=2]
    stage3 -> fail [label="issues found" color="#D32F2F" penwidth=2]
    fail -> stage1 [label="retry" style=dashed color="#F44336"]
}

digraph agent_hierarchy {
    rankdir=TB
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    // Main agent
    node [fillcolor="#1565C0" color="#0D47A1" fontcolor="white" fontsize=12]
    main [label="Main Agent (Sonnet)\nOwns all decisions\nInvestigates & fixes"]

    // Orchestrator skills
    node [fillcolor="#7E57C2" color="#4527A0" fontcolor="white" fontsize=10]
    cr [label="/cr Orchestrator\n(Sonnet)\n3-15 agents"]
    verify [label="/verify-plan\n4-agent pipeline"]
    execute [label="/execute-plan\nTask-by-task"]
    analyze [label="/analyze-migration\nParallel comparison"]

    // Opus agents
    node [fillcolor="#FF7043" color="#BF360C" fontcolor="white"]
    brainstorm [label="/brainstorming\n(Opus)"]
    create_plan [label="/create-plan\n(Opus)"]
    debug_skill [label="/debug\n(Opus)"]
    step_sim [label="step-simulator\n(Opus)\nPlan Prover +\nRegression Hunter"]
    arch_rev [label="architecture-\nreviewer (Opus)"]

    // Sonnet agents
    node [fillcolor="#42A5F5" color="#1565C0" fontcolor="white"]
    code_rev [label="code-reviewer\n(Sonnet)"]
    helper [label="helper-writer\n(Sonnet)"]

    // Haiku agents (fast/cheap)
    node [fillcolor="#66BB6A" color="#2E7D32" fontcolor="white"]
    test_run [label="test-runner\n(Haiku)"]
    static_a [label="static-analyse\n(Haiku)"]
    explorer_a [label="explorer\n(Haiku)"]
    log_a [label="log-analyzer\n(Haiku)"]
    dead [label="dead-code-\ndetector (Haiku)"]
    dup [label="duplicate-\ndetector (Haiku)"]
    web [label="web-researcher\n(Haiku)"]

    // Direct dispatches from main
    main -> brainstorm [label="creative work"]
    main -> create_plan [label="plan features"]
    main -> debug_skill [label="investigate bugs"]
    main -> test_run [label="run tests"]
    main -> static_a [label="lint/format"]
    main -> explorer_a [label="search code"]
    main -> log_a [label="parse errors"]
    main -> helper [label="write utils"]
    main -> web [label="research"]

    // Orchestrator dispatches
    main -> cr [label="/cr" penwidth=2]
    main -> verify [label="/verify-plan" penwidth=2]
    main -> execute [label="/execute-plan" penwidth=2]
    main -> analyze [label="/analyze-migration" penwidth=2]

    cr -> code_rev [color="#7E57C2"]
    cr -> arch_rev [color="#7E57C2"]
    cr -> dead [color="#7E57C2"]
    cr -> dup [color="#7E57C2"]
    cr -> test_run [color="#7E57C2"]
    cr -> static_a [color="#7E57C2"]

    verify -> explorer_a [color="#7E57C2"]
    verify -> step_sim [color="#7E57C2"]
    verify -> code_rev [color="#7E57C2"]

    execute -> test_run [color="#7E57C2"]
    execute -> static_a [color="#7E57C2"]

    // Legend
    subgraph cluster_legend {
        label="Model Tiers" labeljust=l fontsize=10 style=dashed color="#CCCCCC"
        node [shape=plaintext fontcolor="black" fillcolor=transparent color=transparent fontsize=9]
        edge [style=invis]
        l_opus [label="Opus = Deep reasoning, creative"]
        l_sonnet [label="Sonnet = Balanced, code review"]
        l_haiku [label="Haiku = Fast, reporting, search"]
        l_opus -> l_sonnet -> l_haiku
    }
}

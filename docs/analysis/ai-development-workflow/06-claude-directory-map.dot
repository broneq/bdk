digraph claude_directory {
    rankdir=TB
    bgcolor="white"
    node [fontname="Helvetica" fontsize=9 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#AAAAAA"]

    // Root
    node [fillcolor="#37474F" color="#263238" fontcolor="white" fontsize=11]
    root [label=".claude/"]

    // Main categories
    node [fillcolor="#1565C0" color="#0D47A1" fontcolor="white" fontsize=10]
    skills_dir [label="skills/ (18)"]
    agents_dir [label="agents/ (11)"]
    hooks_dir [label="hooks/ (5)"]
    rules_dir [label="rules/ (19)"]

    node [fillcolor="#558B2F" color="#33691E" fontcolor="white" fontsize=10]
    settings [label="settings.json"]
    settings_local [label="settings.local.json"]
    claude_md [label="CLAUDE.md"]

    node [fillcolor="#6A1B9A" color="#4A148C" fontcolor="white" fontsize=10]
    tests_dir [label="tests/"]
    worktrees_dir [label="worktrees/"]

    root -> skills_dir
    root -> agents_dir
    root -> hooks_dir
    root -> rules_dir
    root -> settings
    root -> settings_local
    root -> claude_md
    root -> tests_dir
    root -> worktrees_dir

    // Skills breakdown
    node [fillcolor="#42A5F5" color="#1E88E5" fontcolor="white" fontsize=8]
    sk_lifecycle [label="Lifecycle Skills\nbrainstorming-session\ncreate-plan\nverify-plan\nexecute-plan\ncommit"]
    sk_quality [label="Quality Skills\ncr\ntest-driven-development\nrefactor\nsimplify"]
    sk_docs [label="Documentation Skills\ncreate-adr\nexplain-complex-code\nupdate-docs\ngraphviz-docs-compiler"]
    sk_support [label="Support Skills\ndebug\ncreate-fixture\nanalyze-migration\nsave-progress\nrestore-progress"]

    skills_dir -> sk_lifecycle
    skills_dir -> sk_quality
    skills_dir -> sk_docs
    skills_dir -> sk_support

    // Agents breakdown
    node [fillcolor="#66BB6A" color="#43A047" fontcolor="white" fontsize=8]
    ag_review [label="Review Agents\ncode-reviewer\narchitecture-reviewer\ndead-code-detector\nduplicate-detector"]
    ag_exec [label="Execution Agents\ntest-runner\nstatic-analyse\nhelper-writer\nstep-simulator"]
    ag_research [label="Research Agents\nexplorer\nweb-researcher\nlog-analyzer"]

    agents_dir -> ag_review
    agents_dir -> ag_exec
    agents_dir -> ag_research

    // Hooks breakdown
    node [fillcolor="#FFA726" color="#EF6C00" fontcolor="white" fontsize=8]
    hk_list [label="format-python.sh\ntypecheck-python.sh\nensure-directories.sh\ncheck_rules_drift.py\nsetup-worktree.py"]

    hooks_dir -> hk_list

    // Rules breakdown
    node [fillcolor="#EF5350" color="#C62828" fontcolor="white" fontsize=8]
    rl_arch [label="Architecture\narchitecture.md\nschemas.md\nrest-api.md"]
    rl_quality [label="Code Quality\ncode-quality.md\ntyping.md\nutility-classes.md"]
    rl_testing [label="Testing\ntesting-conventions.md\ntesting-assertions.md\ntesting-fixtures.md"]
    rl_domain [label="Domain\nline-transformer.md\nverification.md\nsea-parser.md\nxml-parser.md\ntemplate-rules.md"]
    rl_workflow [label="Workflow\nsubagent-strategy.md\ntask-completion.md\nskill-script-tests.md\nskill-test-eval.md"]

    rules_dir -> rl_arch
    rules_dir -> rl_quality
    rules_dir -> rl_testing
    rules_dir -> rl_domain
    rules_dir -> rl_workflow
}

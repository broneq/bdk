digraph persistence {
    rankdir=LR
    bgcolor="white"
    node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box]
    edge [fontname="Helvetica" fontsize=8 color="#666666"]

    subgraph cluster_within_session {
        label="Within Session" labeljust=l fontsize=11 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#E3F2FD" color="#90CAF9"
        node [fillcolor="#BBDEFB" color="#1976D2"]

        tasks [label="TaskList\n(progress tracking)"]
        plans [label="Plans\n(docs/plans/)"]
        context [label="Conversation\nContext"]
    }

    subgraph cluster_cross_session {
        label="Cross-Session" labeljust=l fontsize=11 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#E8F5E9" color="#A5D6A7"
        node [fillcolor="#C8E6C9" color="#388E3C"]

        progress [label="save/restore-progress\n(docs/progress/)"]
        claude_mem [label="claude-mem MCP\n(observations DB)"]
        serena_mem [label="Serena Memories\n(test helpers, fixtures)"]
        auto_mem [label="Auto Memory\n(~/.claude/.../memory/)"]
    }

    subgraph cluster_permanent {
        label="Permanent (Git)" labeljust=l fontsize=11 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#FFF3E0" color="#FFB74D"
        node [fillcolor="#FFE0B2" color="#F57C00"]

        rules [label=".claude/rules/\n(19 files)"]
        skills_p [label=".claude/skills/\n(18 skills)"]
        agents_p [label=".claude/agents/\n(11 agents)"]
        hooks_p [label=".claude/hooks/\n(5 scripts)"]
        settings_p [label=".claude/settings.json"]
        claude_md_p [label="CLAUDE.md\n(project instructions)"]
    }

    subgraph cluster_codegraph {
        label="Code Index" labeljust=l fontsize=11 fontname="Helvetica-Bold"
        style="rounded,filled" fillcolor="#F3E5F5" color="#CE93D8"
        node [fillcolor="#E1BEE7" color="#7B1FA2"]

        codegraph [label="CodeGraph\n(.codegraph/)\nSemantic code graph"]
    }

    // Connections
    context -> tasks [label="track work"]
    context -> plans [label="reference"]
    context -> progress [label="/save-progress" style=dashed]
    progress -> context [label="/restore-progress" style=dashed]

    context -> claude_mem [label="search/store" color="#388E3C"]
    context -> serena_mem [label="load helpers" color="#388E3C"]
    context -> auto_mem [label="user prefs\nproject state" color="#388E3C"]

    rules -> context [label="auto-loaded" color="#F57C00"]
    skills_p -> context [label="on invoke" color="#F57C00"]
    agents_p -> context [label="on spawn" color="#F57C00"]
    hooks_p -> context [label="lifecycle\nevents" color="#F57C00"]

    codegraph -> context [label="symbol search\ncallers/callees" color="#7B1FA2"]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "kernel/src/main.ts",
    "kernel/src/shared/*/index.ts",
    "kernel/scripts/export-schemas.ts",
    "skill-check.config.ts",
    "evals/suites/*/hooks.ts"
  ],
  "project": [
    "kernel/**/*.ts",
    "kernel/**/*.mjs",
    "evals/**/*.ts",
    "docs/guide/.vitepress/**/*.ts"
  ],
  "ignore": ["evals/suites/*/hidden/**"],
  "tags": ["-public"],
  "ignoreBinaries": ["uv", "openspec"],
  "vitepress": {
    "config": ["docs/guide/.vitepress/config.ts"],
    "entry": ["docs/guide/.vitepress/theme/index.ts"]
  }
}

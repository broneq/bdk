# skill eval harness: fixture cache, plugin copies, per-run copies, raw outputs
/evals/.runs/

# generated by `pnpm build` (kernel-architecture, Generated outputs): built by
# `prepare`, CI and the release job, published on the `release` branch, never
# committed. The hand-written files next to them stay tracked:
# schema/cli/commands.json, schema/cli/commands.schema.json,
# schema/cli/common/list-page.json and agents/web-researcher.md.
/dist/
/schema/settings.json
/schema/pipeline.json
/schema/state/
/schema/cli/output/
/schema/cli/common/version.json
/schema/cli/common/refusal.json
# `bdk export agents --host claude`: every file of agents/ but the hand-written one
/agents/*
!/agents/web-researcher.md

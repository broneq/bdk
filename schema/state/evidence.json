{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/evidence.json",
  "title": "Evidence manifest",
  "type": "object",
  "properties": {
    "schema": { "type": "number", "const": 1 },
    "id": { "$ref": "common.json#/$defs/evidenceId" },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "`tests-scoped`, `lint`, `tests-full`, `lint-full`, `coverage`, `typecheck`, `ui-capture` or a project kind."
    },
    "ticket": { "$ref": "common.json#/$defs/ticketId" },
    "group": {
      "description": "The review group of the record.",
      "$ref": "common.json#/$defs/reviewGroup"
    },
    "tool": {
      "description": "Only on `coverage`: the `tools.test` id measured.",
      "type": "string",
      "minLength": 1
    },
    "target": { "type": "string", "minLength": 1 },
    "at": { "$ref": "common.json#/$defs/timestamp" },
    "author": { "$ref": "common.json#/$defs/author" },
    "source": {
      "anyOf": [
        { "type": "string", "const": "kernel" },
        { "$ref": "common.json#/$defs/agentSource" }
      ]
    },
    "tree-hash": { "$ref": "common.json#/$defs/hash" },
    "tree": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "$ref": "common.json#/$defs/relativePath" },
          "hash": {
            "anyOf": [
              { "$ref": "common.json#/$defs/hash" },
              { "type": "string", "const": "absent" }
            ]
          }
        },
        "required": ["path", "hash"],
        "additionalProperties": false
      },
      "description": "The covered files the tree hash was computed over, in path order; `absent` for a deleted file."
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "$ref": "common.json#/$defs/relativePath" },
          "hash": { "$ref": "common.json#/$defs/hash" },
          "stored": { "type": "string", "enum": ["committed", "machine"] }
        },
        "required": ["path", "hash", "stored"],
        "additionalProperties": false
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "fail", "not-run"] },
    "citations": {
      "description": "JSON pointers or snapshot lines (citation validator).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schema",
    "id",
    "kind",
    "ticket",
    "target",
    "at",
    "author",
    "source",
    "tree-hash",
    "tree",
    "files"
  ],
  "additionalProperties": false
}

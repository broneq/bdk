{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/entry.json",
  "title": "Ledger entry",
  "description": "One file per entry; the body is free Markdown.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "decision" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "profile": {
          "description": "Written only by kernel commands that raise the profile; raises the effective profile.",
          "type": "string",
          "enum": ["small", "large"]
        }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "finding" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "severity": { "$ref": "common.json#/$defs/severity" },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "One of the P8 blocking categories."
        }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },

        "review": { "type": "boolean" },
        "severity": { "$ref": "common.json#/$defs/severity" }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "blocker" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "One of the P8 blocking categories."
        }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "question" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "park": {
          "description": "Written only by `change park` and by `attempt close` at the end of the ladder; marks the question that parks the Change.",
          "type": "boolean"
        }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "assumption" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "risk" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },

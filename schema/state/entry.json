        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" }
      },
      "required": ["schema", "id", "type", "summary", "status", "source", "author", "at", "refs"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "learning" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "fingerprint": {
          "description": "Kernel-stamped (`kernel-state`, Fingerprints).",
          "$ref": "common.json#/$defs/hash"
        },
        "evidence": { "type": "array", "items": { "$ref": "common.json#/$defs/idReference" } },
        "applies": {
          "description": "The files the lesson is about.",
          "type": "array",
          "items": { "$ref": "common.json#/$defs/glob" }
        }
      },
      "required": [
        "schema",
        "id",
        "type",
        "summary",
        "status",
        "source",
        "author",
        "at",
        "refs",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "report" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "report": { "$ref": "common.json#/$defs/relativePath" }
      },
      "required": [
        "schema",
        "id",
        "type",
        "summary",
        "status",
        "source",
        "author",
        "at",
        "refs",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "type": "number", "const": 1 },
        "id": { "$ref": "common.json#/$defs/ledgerId" },
        "type": { "type": "string", "const": "transition" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "resolved"],
          "description": "`superseded` is derived from `supersedes`, never stored."
        },
        "source": { "$ref": "common.json#/$defs/provenance" },
        "author": { "$ref": "common.json#/$defs/author" },
        "at": { "$ref": "common.json#/$defs/timestamp" },
        "ticket": { "$ref": "common.json#/$defs/ticketId" },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "$ref": "common.json#/$defs/idReference" },
        "review": { "type": "boolean" },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "Stage, artifact id, gate id or `closed`."
        },
        "gate": { "type": "string", "minLength": 1 },
        "session": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "skip-verify": { "type": "boolean" },
        "auto": {
          "description": "A gate passed by policy because the run had --auto; written only by the hooks (T41). Such a transition counts at a manual gate.",
          "type": "boolean"
        },
        "input-hash": {
          "description": "sha256 of the node's inputs; written only by `done` and `part done` (P2). A transition carrying it is the node's done marker.",
          "$ref": "common.json#/$defs/hash"
        }
      },
      "required": [
        "schema",
        "id",
        "type",
        "summary",
        "status",
        "source",
        "author",
        "at",
        "refs",
        "to"
      ],
      "additionalProperties": false
    }

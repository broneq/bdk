{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/pruned.json",
  "title": "Pruned index",
  "type": "object",
  "properties": {
    "schema": { "type": "number", "const": 1 },
    "dir": {
      "type": "string",
      "enum": ["dispatch", "reports"],
      "description": "The directory it indexes."
    },
    "at": { "$ref": "common.json#/$defs/timestamp" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\]+$",
            "description": "The removed file's name within `dir`."
          },
          "hash": { "$ref": "common.json#/$defs/hash" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["path", "hash", "bytes"],
        "additionalProperties": false
      },
      "description": "Each removed file: name, `sha256:` hash, size."
    }
  },
  "required": ["schema", "dir", "at", "files"],
  "additionalProperties": false
}

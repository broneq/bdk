{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/dispatch.json",
  "title": "Dispatch package",
  "type": "object",
  "properties": {
    "schema": { "type": "number", "const": 1 },
    "ticket": { "$ref": "common.json#/$defs/ticketId" },
    "target": { "type": "string", "minLength": 1 },
    "role": { "$ref": "common.json#/$defs/role" },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "description": "The role's adapter (`role-contracts`, Role-to-adapter map)."
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "of": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "scope": { "$ref": "common.json#/$defs/scope" },
    "model": {
      "description": "The model the agent must run on: the escalation ticket's `model`, for every role but `runner` and `scout` (T41-D14).",
      "type": "string",
      "minLength": 1
    },
    "at": { "$ref": "common.json#/$defs/timestamp" },
    "kernel-version": { "type": "string", "minLength": 1 },
    "template-hash": { "$ref": "common.json#/$defs/hash" },
    "report": {
      "description": "Where the role's report is written.",
      "$ref": "common.json#/$defs/relativePath"
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[1-9][0-9]*$" },
      "description": "The rules selected for the ticket, in order (T31); may be empty."
    },
    "group": {
      "description": "Review group of a `dispatch build --group` package (T42-A1).",
      "$ref": "common.json#/$defs/reviewGroup"
    },
    "files": {
      "description": "The group's file set; present exactly when `group` is.",
      "type": "array",
      "items": { "$ref": "common.json#/$defs/relativePath" }
    }
  },
  "required": [
    "schema",
    "ticket",
    "target",
    "role",
    "adapter",
    "attempt",
    "of",
    "scope",
    "at",
    "kernel-version",
    "template-hash",
    "report",
    "rules"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/design-index.json",
  "title": "Design index",
  "description": "Generated from the design parts; never edited.",
  "type": "object",
  "properties": {
    "schema": { "type": "number", "const": 1 },
    "generated": { "type": "boolean", "const": true },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{2}$",
            "description": "Two digits, equal to `<nn>` of the file name."
          },
          "title": { "type": "string", "minLength": 1 },
          "depends-on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{2}$",
              "description": "Two digits, equal to `<nn>` of the file name."
            }
          }
        },
        "required": ["id", "title", "depends-on"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "generated", "parts"],
  "additionalProperties": false
}

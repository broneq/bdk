{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/state/attempt.json",
  "title": "Attempt record",
  "description": "The body is the close reason.",
  "type": "object",
  "properties": {
    "schema": { "type": "number", "const": 1 },
    "ticket": { "$ref": "common.json#/$defs/ticketId" },
    "loop": {
      "type": "string",
      "enum": ["task-redispatch", "verify-fix", "review-fix", "verifier"],
      "description": "The loop the ticket counts against (`kernel-loops`, Loops, targets and rounds)."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Task id (task-redispatch), part id (verify-fix), Change id (review-fix) or artifact id (verifier)."
    },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "of": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "scope": { "$ref": "common.json#/$defs/scope" },
    "narrowed-from": { "$ref": "common.json#/$defs/scope" },
    "escalation": {
      "description": "The round's one-shot escalation ticket (`attempt open --escalate`); not counted against `of`.",
      "type": "boolean"
    },
    "opened-at": { "$ref": "common.json#/$defs/timestamp" },
    "author": { "$ref": "common.json#/$defs/author" },
    "closed-at": {
      "description": "Present exactly when `outcome` is.",
      "$ref": "common.json#/$defs/timestamp"
    },
    "outcome": { "type": "string", "enum": ["ok", "fail", "not-run"] },
    "findings": {
      "description": "Finding fingerprints of a `fail` (oscillation check).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": { "$ref": "common.json#/$defs/hash" },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "finding",
              "observation",
              "blocker",
              "question",
              "assumption",
              "risk",
              "learning",
              "report",
              "transition"
            ]
          },
          "file": { "$ref": "common.json#/$defs/relativePath" },
          "symbol": { "type": "string", "minLength": 1 }
        },
        "required": ["fingerprint", "type", "file"],
        "additionalProperties": false
      }
    },
    "dropped": { "type": "array", "items": { "$ref": "common.json#/$defs/ledgerId" } },
    "rules-read": {
      "description": "First `rules show --ticket` call for the ticket (risk R2); read by `attempt close`.",
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "required": [
    "schema",
    "ticket",
    "loop",
    "target",
    "attempt",
    "of",
    "scope",
    "opened-at",
    "author"
  ],
  "additionalProperties": false
}

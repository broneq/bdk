{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/config-show.json",
  "title": "bdk config show --json",
  "description": "The resolved configuration after the four layers, with the origin of every key.",
  "type": "object",
  "properties": {
    "key": {
      "description": "The requested dotted key; absent for the whole tree.",
      "type": "string"
    },
    "value": {
      "description": "The resolved value or subtree; a prompt value is its effective mode and contributing files."
    },
    "origins": {
      "description": "Dotted leaf key -> the layer it came from, with --origins.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "string",
        "enum": ["default", "global", "project", "local"]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": { "type": "string", "enum": ["global", "project", "local"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "The layer file: relative to the project root, absolute for the global layer."
          },
          "present": { "type": "boolean" }
        },
        "required": ["layer", "path", "present"],
        "additionalProperties": false
      },
      "description": "Every file layer, lowest first, and whether its file exists."
    }
  },
  "required": ["value", "layers"],
  "additionalProperties": false,
  "examples": [
    {
      "key": "tools.test",
      "value": [
        {
          "id": "unit",
          "tier": "fast",
          "command": "pnpm test:unit",
          "scoped": "pnpm vitest run {files}"
        }
      ],
      "origins": {
        "tools.test.unit.tier": "project",
        "tools.test.unit.command": "project",
        "tools.test.unit.scoped": "local"
      },
      "layers": [
        { "layer": "global", "path": "/home/dev/.config/bdk/settings.yaml", "present": false },
        { "layer": "project", "path": ".bdk/settings.yaml", "present": true },
        { "layer": "local", "path": ".bdk/settings.local.yaml", "present": true }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/ctx.json",
  "title": "bdk ctx skill|startup --json",
  "description": "The prompt context of a skill or the STARTUP instructions; an error is the refusal object, still with exit 0.",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The composed Markdown, identical to the inject-mode output."
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "rules",
              "language-rules",
              "fragment",
              "tools",
              "file",
              "startup",
              "agents-table"
            ]
          },
          "source": {
            "type": "string",
            "description": "The prompt key (rules/security), tools group (tools.test) or plugin path that produced the part."
          }
        },
        "required": ["kind", "source"],
        "additionalProperties": false
      },
      "description": "The parts of the content, in output order."
    }
  },
  "required": ["content", "parts"],
  "additionalProperties": false,
  "examples": [
    {
      "content": "## BDK context: design\n\n### Rules: architecture\n...",
      "parts": [
        { "kind": "rules", "source": "rules/architecture" },
        { "kind": "rules", "source": "rules/engineering-judgment" },
        { "kind": "fragment", "source": "fragments/decision/ask-user" }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-list.json",
  "title": "bdk log list --json",
  "description": "Ledger entries as summaries, filtered by type, status, review flag or reference.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/list-page.json"
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "summary", "status", "source", "at", "refs"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
              },
              "type": {
                "enum": [
                  "decision",
                  "finding",
                  "observation",
                  "blocker",
                  "question",
                  "assumption",
                  "risk",
                  "learning",
                  "report",
                  "transition"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 120
              },
              "status": {
                "enum": ["proposed", "accepted", "superseded", "resolved", "routed"]
              },
              "source": {
                "type": "string",
                "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$"
              },
              "author": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC with seconds."
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "review": {
                "type": "boolean"
              },
              "supersedes": {
                "type": "string",
                "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "examples": [
    {
      "items": [
        {
          "id": "L-a2s5d",
          "type": "decision",
          "summary": "magic links, no passwords, WebAuthn later",
          "status": "accepted",
          "source": "user",
          "at": "2026-09-25T09:12:30Z",
          "refs": ["design.md"]
        }
      ],
      "total": 1,
      "truncated": false
    }
  ]
}

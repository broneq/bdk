{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-list.json",
  "title": "bdk log list --json",
  "description": "Ledger entries as summaries, filtered by type, status, review flag or reference.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "finding",
              "observation",
              "blocker",
              "question",
              "assumption",
              "risk",
              "learning",
              "report",
              "transition"
            ]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": {
            "type": "string",
            "enum": ["proposed", "accepted", "superseded", "resolved"],
            "description": "Derived: `superseded` when another entry names this one in `supersedes`."
          },
          "source": {
            "type": "string",
            "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$",
            "description": "Who produced the entry (P1); stamped by the kernel."
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
            "description": "ISO 8601 UTC with milliseconds."
          },
          "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
          "review": { "description": "Present only when true.", "type": "boolean", "const": true },
          "ticket": { "type": "string" },
          "category": { "type": "string" },
          "supersedes": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "supersededBy": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          }
        },
        "required": ["id", "type", "summary", "status", "source", "at", "refs"],
        "additionalProperties": false
      }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "truncated": { "type": "boolean" },
    "for": { "description": "The --for filter as given.", "type": "string" }
  },
  "required": ["items", "total", "truncated"],
  "additionalProperties": false,
  "examples": [
    {
      "items": [
        {
          "id": "L-m2x9v7qa",
          "type": "decision",
          "summary": "magic links, no passwords, WebAuthn later",
          "status": "accepted",
          "source": "kernel",
          "at": "2026-09-25T09:41:07.123Z",
          "refs": ["design.md"]
        }
      ],
      "total": 1,
      "truncated": false
    }
  ]
}

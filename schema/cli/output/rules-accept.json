{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-accept.json",
  "title": "bdk rules accept --json",
  "description": "Adopt a rule: write `.bdk/rules/<PREFIX>-<n>.md` from the user's decision and regenerate the projection.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[1-9][0-9]*$" },
    "path": { "type": "string", "minLength": 1, "description": "Relative to the project root." },
    "origin": { "type": "string", "minLength": 1 },
    "projection": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "description": "Relative to the project root." },
      "description": "The projection files the adoption rewrote."
    }
  },
  "required": ["id", "path", "origin", "projection"],
  "additionalProperties": false,
  "examples": [
    {
      "id": "ARCHP-1",
      "path": ".bdk/rules/ARCHP-1.md",
      "origin": "2026-09-25-passwordless-login/L-m2x9v7qa",
      "projection": [".claude/rules/bdk-generated-scoped.md"]
    }
  ]
}

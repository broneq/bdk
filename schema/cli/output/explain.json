{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/explain.json",
  "title": "bdk explain --json",
  "description": "Why an artifact is in its state: the `requires` chain with each node's state and input hash.",
  "type": "object",
  "properties": {
    "artifact": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["blocked", "ready", "done", "stale", "skipped"] },
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Artifact kind from pipeline.yaml (T21)."
          },
          "state": { "type": "string", "enum": ["blocked", "ready", "done", "stale", "skipped"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "why": {
            "description": "For blocked, stale, skipped and gates: what is missing or what changed.",
            "type": "string"
          }
        },
        "required": ["id", "kind", "state"],
        "additionalProperties": false
      },
      "description": "The artifact, then its transitive requirements, latest first."
    },
    "profile": { "type": "string", "enum": ["tiny", "small", "large"] },
    "conditions": {
      "description": "if: features.X conditions that applied.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["artifact", "state", "chain", "profile"],
  "additionalProperties": false,
  "examples": [
    {
      "artifact": "plan-verify",
      "state": "blocked",
      "profile": "small",
      "chain": [
        {
          "id": "plan-verify",
          "kind": "plan-verify",
          "state": "blocked",
          "requires": ["plan-part:01"],
          "why": "plan-part:01 is ready, not done"
        },
        {
          "id": "plan-part:01",
          "kind": "plan-part",
          "state": "ready",
          "requires": ["gate:design"]
        },
        { "id": "gate:design", "kind": "gate", "state": "done" }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/hooks-pre-tool.json",
  "title": "bdk hooks pre-tool --json",
  "description": "PreToolUse guard: the kernel's own record of a pass, used by tests. A block is the error object under --json and the host's deny object otherwise.",
  "type": "object",
  "properties": {
    "decision": { "type": "string", "const": "pass" },
    "tool": { "type": "string", "description": "The payload's tool_name." },
    "subagent": { "type": "boolean", "description": "Whether the payload carries agent_id." }
  },
  "required": ["decision", "tool", "subagent"],
  "additionalProperties": false,
  "examples": [{ "decision": "pass", "tool": "Bash", "subagent": false }]
}

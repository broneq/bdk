{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-check.json",
  "title": "bdk rules check --json",
  "description": "Check the rule files of the bundle and the project: ids, the frontmatter, knowledge sources, tombstones and rules.disabled.",
  "type": "object",
  "properties": {
    "valid": { "type": "boolean", "const": true },
    "rules": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Rule files checked, tombstones included."
    },
    "bundle": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "project": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "tombstones": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "required": ["valid", "rules", "bundle", "project", "tombstones"],
  "additionalProperties": false,
  "examples": [{ "valid": true, "rules": 87, "bundle": 81, "project": 6, "tombstones": 1 }]
}

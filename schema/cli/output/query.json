{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/query.json",
  "title": "bdk query --json",
  "description": "Read-only SQL over the rebuildable index.",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Column names in select order."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": ["string", "number", "null"] },
        "description": "One row as an array of scalars in column order."
      }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "truncated": { "type": "boolean" }
  },
  "required": ["columns", "items", "total", "truncated"],
  "additionalProperties": false,
  "examples": [
    {
      "columns": ["type", "count(*)"],
      "items": [
        ["decision", 4],
        ["finding", 7]
      ],
      "total": 2,
      "truncated": false
    }
  ]
}

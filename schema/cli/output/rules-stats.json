{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-stats.json",
  "title": "bdk rules stats --json",
  "description": "The audit view: recurring items across Changes, the raw findings and learnings, and citations by rule id.",
  "type": "object",
  "properties": {
    "minChanges": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "recurring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "changes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Distinct Changes the fingerprint appears in."
          },
          "occurrences": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "changeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["fingerprint", "summary", "changes", "occurrences", "changeIds"],
        "additionalProperties": false
      },
      "description": "Fingerprints of learning entries and attempt findings seen in at least minChanges distinct Changes."
    },
    "entries": {
      "description": "With --entries: every learning, finding and blocker entry and every attempt finding, newest first.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "`<changeId>/<entry id>` for an entry, `<changeId>/<ticket>` for an attempt finding."
              },
              "source": { "type": "string", "enum": ["entry", "attempt"] },
              "type": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "refs": { "type": "array", "items": { "type": "string" } },
              "applies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "adopted": {
                "type": "boolean",
                "description": "True when a rule's origin or evidence names the item."
              }
            },
            "required": ["id", "source", "type", "summary", "refs", "at", "adopted"],
            "additionalProperties": false
          }
        },
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "truncated": { "type": "boolean" }
      },
      "required": ["items", "total", "truncated"],
      "additionalProperties": false
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[1-9][0-9]*$" },
          "entries": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "changes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["id", "entries", "changes"],
        "additionalProperties": false
      },
      "description": "Entries naming each rule id in refs, rules never cited included."
    }
  },
  "required": ["minChanges", "recurring", "citations"],
  "additionalProperties": false,
  "examples": [
    {
      "minChanges": 3,
      "recurring": [
        {
          "fingerprint": "sha256:9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c",
          "summary": "scoped test run missed the negative case",
          "changes": 3,
          "occurrences": 5,
          "changeIds": [
            "2026-09-25-passwordless-login",
            "2026-09-27-export-csv",
            "2026-09-29-audit-log"
          ]
        }
      ],
      "citations": [{ "id": "BDK-CQ-4", "entries": 12, "changes": 4 }]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/attempt-close.json",
  "title": "bdk attempt close --json",
  "description": "Close a ticket with its outcome; check the diff, the evidence and the declared entries.",
  "type": "object",
  "properties": {
    "ticket": {
      "type": "string",
      "pattern": "^A-[0-9a-z]{8}$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "outcome": { "type": "string", "enum": ["ok", "fail", "not-run"] },
    "diff": {
      "description": "The diff check; absent for a verifier ticket.",
      "type": "object",
      "properties": {
        "declared": {
          "type": "array",
          "items": { "type": "string", "description": "Path relative to the project root." }
        },
        "touched": {
          "type": "array",
          "items": { "type": "string", "description": "Path relative to the project root." }
        },
        "undeclared": {
          "type": "array",
          "items": { "type": "string", "description": "Path relative to the project root." },
          "description": "Files outside Files:, recorded as a kernel finding entry."
        }
      },
      "required": ["declared", "touched", "undeclared"],
      "additionalProperties": false
    },
    "findings": {
      "description": "Kernel finding entries the close wrote.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^L-[0-9a-z]{8}$",
        "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
      }
    },
    "fingerprints": {
      "description": "Fingerprints stored on a fail record (`kernel-loops`, oscillation).",
      "type": "array",
      "items": { "type": "string" }
    },
    "rulesFinding": {
      "description": "The reviewed kernel finding written when an implementer ticket closes without `rules-read` (T23-D28).",
      "type": "string",
      "pattern": "^L-[0-9a-z]{8}$"
    },
    "notRunCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The round's consecutive not-run closes."
    },
    "next": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["commit", "part-done", "review-done", "retry", "narrow", "escalate", "parked"],
          "description": "commit after ok, the step evidence having passed; part-done after ok of a part-lead ticket; review-done after ok of a review-fix ticket; the ladder's rung after fail or not-run."
        },
        "scope": { "type": "string", "enum": ["full", "high+", "blockers"] },
        "entry": {
          "description": "The ladder question that parks the Change.",
          "type": "string",
          "pattern": "^L-[0-9a-z]{8}$"
        },
        "why": { "type": "string" },
        "resume": { "description": "The command that answers the question.", "type": "string" }
      },
      "required": ["action"],
      "additionalProperties": false
    }
  },
  "required": ["ticket", "outcome", "notRunCount", "next"],
  "additionalProperties": false,
  "examples": [
    {
      "ticket": "A-7f3k9m2q",
      "outcome": "fail",
      "diff": {
        "declared": ["src/auth/login.ts"],
        "touched": ["src/auth/login.ts", "src/auth/util.ts"],
        "undeclared": ["src/auth/util.ts"]
      },
      "findings": ["L-e8k2s5vw"],
      "fingerprints": ["sha256:3f1c9a0b7d2e4c6f8a1b3d5e7f9a0c2e4b6d8f0a1c3e5a7b9d1f3a5c7e9b1d3f"],
      "notRunCount": 0,
      "next": { "action": "narrow", "scope": "blockers" }
    }
  ]
}

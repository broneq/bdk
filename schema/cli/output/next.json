{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/next.json",
  "title": "bdk next --json",
  "description": "The next ready artifact with its instruction, plus the gate status; the skill's entry point.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "description": "The stage the Change is in, from its latest transition; not necessarily the stage of `artifact`."
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact kind from pipeline.yaml (T21)."
        },
        "state": { "type": "string", "enum": ["blocked", "ready", "done", "stale", "skipped"] },
        "requires": { "type": "array", "items": { "type": "string" } },
        "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "why": {
          "description": "For blocked, stale, skipped and gates: what is missing or what changed.",
          "type": "string"
        }
      },
      "required": ["id", "kind", "state"],
      "additionalProperties": false
    },
    "command": {
      "description": "With an artifact: the command of the artifact's stage, the skill that does it, e.g. /bdk:execute.",
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "description": "Markdown built from the kind's template, rules and ledger (T21).",
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1,
            "description": "Gate node id, e.g. gate:design."
          },
          "ready": { "type": "boolean" },
          "done": { "type": "boolean" },
          "passedBy": { "type": "string", "enum": ["user", "policy"] },
          "command": {
            "description": "The stage command the user types to pass it, e.g. /bdk:plan.",
            "type": "string"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^L-[0-9a-z]{8}$",
                  "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "decision",
                    "finding",
                    "observation",
                    "blocker",
                    "question",
                    "assumption",
                    "risk",
                    "learning",
                    "report",
                    "transition"
                  ]
                },
                "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
                "status": {
                  "type": "string",
                  "enum": ["proposed", "accepted", "superseded", "resolved"]
                },
                "source": {
                  "type": "string",
                  "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$"
                },
                "author": { "type": "string" },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                  "description": "ISO 8601 UTC with milliseconds."
                },
                "refs": { "minItems": 1, "type": "array", "items": { "type": "string" } },
                "review": { "type": "boolean" },
                "supersedes": {
                  "type": "string",
                  "pattern": "^L-[0-9a-z]{8}$",
                  "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
                }
              },
              "required": ["id", "type", "summary", "status", "source", "at", "refs"],
              "additionalProperties": false
            },
            "description": "review: true entries listed, never dispositioned."
          }
        },
        "required": ["gate", "ready", "done", "pending"],
        "additionalProperties": false,
        "description": "What the user sees before typing the next stage command (T1)."
      }
    },
    "waiting": {
      "description": "Set when no artifact is actionable: what the Change waits for.",
      "type": "string",
      "enum": ["gate", "user", "nothing"]
    },
    "wave": {
      "description": "With an execute-part artifact: every ready part with its tickets and mode (T41-D3).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": { "type": "string", "description": "The plan part's two-digit id." },
          "started": { "type": "boolean", "description": "`bdk part start` ran for the part." },
          "tickets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Open tickets of the part or of its tasks, oldest first."
          },
          "mode": {
            "type": "string",
            "enum": ["flat", "tree"],
            "description": "flat: main dispatches the part's tasks; tree: one lead runs the part."
          }
        },
        "required": ["part", "started", "tickets", "mode"],
        "additionalProperties": false
      }
    }
  },
  "required": ["change", "stage", "gates"],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "stage": "plan",
      "artifact": {
        "id": "plan-part:01",
        "kind": "plan-part",
        "state": "ready",
        "requires": ["gate:design"]
      },
      "command": "/bdk:plan",
      "instruction": "# plan-part:01 (plan-part)\n\nWrite plan part plan-part:01 ...\n",
      "gates": [
        { "gate": "gate:design", "ready": true, "done": true, "passedBy": "user", "pending": [] }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/done.json",
  "title": "bdk done --json",
  "description": "Mark an artifact done after its validator passes and record the input hash.",
  "type": "object",
  "properties": {
    "artifact": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "const": "done" },
    "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "next": {
      "type": "string",
      "minLength": 1,
      "description": "The artifact next now returns, the gate the Change waits for, user when parked, or nothing."
    },
    "entry": {
      "description": "The entry written, or the existing one when the node was already done.",
      "type": "string",
      "pattern": "^L-[0-9a-z]{8}$"
    }
  },
  "required": ["artifact", "state", "inputHash", "next"],
  "additionalProperties": false,
  "examples": [
    {
      "artifact": "design",
      "state": "done",
      "inputHash": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "next": "gate:design",
      "entry": "L-h6s1d3ne"
    }
  ]
}

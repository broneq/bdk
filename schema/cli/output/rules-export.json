{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-export.json",
  "title": "bdk rules export --json",
  "description": "Generate the host projection of the project's rules: `.claude/rules/bdk-generated.md` and `bdk-generated-scoped.md`.",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the project root."
          },
          "rules": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "paths": {
            "description": "The scoped file's `paths:`: the sorted union of its rules' applies.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "changed": {
            "type": "boolean",
            "description": "True when the file was (or, with --check, would be) rewritten or deleted."
          }
        },
        "required": ["path", "rules", "changed"],
        "additionalProperties": false
      }
    }
  },
  "required": ["files"],
  "additionalProperties": false,
  "examples": [
    {
      "files": [
        { "path": ".claude/rules/bdk-generated.md", "rules": 4, "changed": false },
        {
          "path": ".claude/rules/bdk-generated-scoped.md",
          "rules": 2,
          "paths": ["src/api/**", "web/**/*.tsx"],
          "changed": true
        }
      ]
    }
  ]
}

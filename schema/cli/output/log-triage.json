{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-triage.json",
  "title": "bdk log triage --json",
  "description": "Set the project-level triage level of a finding, blocker or observation.",
  "type": "object",
  "properties": {
    "record": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
      "description": "The triaged entry."
    },
    "level": {
      "type": "string",
      "enum": ["blocker", "should-fix", "nice-to-have", "not-a-problem"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "resolved"],
      "description": "The entry's status after the write: `resolved` for `not-a-problem`."
    }
  },
  "required": ["record", "level", "status"],
  "additionalProperties": false,
  "examples": [{ "record": "L-q2w3e4r5", "level": "should-fix", "status": "proposed" }]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-takeover.json",
  "title": "bdk change takeover --json",
  "description": "Take over a Change whose previous session died with open tickets.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "previousSession": {
      "description": "The session that held the tickets; stamped from T24.",
      "type": "string"
    },
    "closedTickets": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "pattern": "^A-[0-9a-z]{8}$" },
      "description": "The tickets closed as not-run with the body `taken over`."
    },
    "rebuilt": {
      "type": "boolean",
      "description": "The rebuild of `bdk rebuild` ran for the Change."
    }
  },
  "required": ["change", "closedTickets", "rebuilt"],
  "additionalProperties": false,
  "examples": [
    { "change": "2026-09-25-passwordless-login", "closedTickets": ["A-7f3k9m2q"], "rebuilt": true }
  ]
}

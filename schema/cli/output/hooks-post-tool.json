{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/hooks-post-tool.json",
  "title": "bdk hooks post-tool --json",
  "description": "PostToolUse on Agent and TaskStop: the registry link or end it recorded. Text mode prints nothing.",
  "type": "object",
  "properties": {
    "tool": { "type": "string", "description": "The payload's tool_name." },
    "linked": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "parent": { "type": "string", "minLength": 1, "description": "An agent id or `main`." },
            "ticket": { "type": ["string", "null"] }
          },
          "required": ["agent", "parent", "ticket"],
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "The child an `Agent` call linked; null otherwise."
    },
    "ended": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "by": { "type": "string", "enum": ["agent-result", "task-stop"] }
          },
          "required": ["agent", "by"],
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "The agent a foreground result or a `TaskStop` ended; null otherwise."
    }
  },
  "required": ["tool", "linked", "ended"],
  "additionalProperties": false,
  "examples": [
    {
      "tool": "Agent",
      "linked": {
        "agent": "a1b2c3d4e5f6a7b8c",
        "parent": "a9f8e7d6c5b4a3f2e",
        "ticket": "A-9k2m4n6p"
      },
      "ended": null
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-add.json",
  "title": "bdk log add --json",
  "description": "Append one ledger entry; the kernel stamps id, time, author and source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry", "path", "deduplicated"],
  "properties": {
    "entry": {
      "type": "object",
      "required": ["id", "type", "summary", "status", "source", "at", "refs"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Opaque merge-safe id (T14)."
        },
        "type": {
          "enum": [
            "decision",
            "finding",
            "observation",
            "blocker",
            "question",
            "assumption",
            "risk",
            "learning",
            "report",
            "transition"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "enum": ["proposed", "accepted", "superseded", "resolved", "routed"]
        },
        "source": {
          "type": "string",
          "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$"
        },
        "author": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC with seconds."
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "review": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "string",
          "description": "Opaque merge-safe id (T14)."
        }
      }
    },
    "path": {
      "type": "string",
      "description": "Path relative to the project root."
    },
    "deduplicated": {
      "type": "boolean"
    }
  },
  "examples": [
    {
      "entry": {
        "id": "L-e8k2s",
        "type": "finding",
        "summary": "expired magic link still accepted",
        "status": "proposed",
        "source": "agent:implementer",
        "author": "Przemysław Broniszewski",
        "at": "2026-09-25T10:15:02Z",
        "refs": ["src/auth/login.ts", "02-3"],
        "review": false
      },
      "path": ".bdk/changes/2026-09-25-passwordless-login/log/20260925T101502-finding-expired-magic-link.md",
      "deduplicated": false
    }
  ]
}

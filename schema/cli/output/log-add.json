{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-add.json",
  "title": "bdk log add --json",
  "description": "Append one ledger entry; the kernel stamps id, time, author and source.",
  "type": "object",
  "properties": {
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
          "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
        },
        "type": {
          "type": "string",
          "enum": [
            "decision",
            "finding",
            "observation",
            "blocker",
            "question",
            "assumption",
            "risk",
            "learning",
            "report",
            "transition"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "superseded", "resolved"],
          "description": "Derived: `superseded` when another entry names this one in `supersedes`."
        },
        "source": {
          "type": "string",
          "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$",
          "description": "Who produced the entry (P1); stamped by the kernel."
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
        "author": { "type": "string", "minLength": 1 },
        "review": { "type": "boolean" },
        "ticket": { "type": "string" },
        "supersedes": {
          "type": "string",
          "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
          "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
        },
        "fingerprint": { "type": "string" },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "park": { "type": "boolean" },
        "profile": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "applies": { "type": "array", "items": { "type": "string" } },
        "report": { "type": "string" },
        "to": { "type": "string" },
        "gate": { "type": "string" },
        "session": { "type": "string" },
        "command": { "type": "string" },
        "skipVerify": { "type": "boolean" },
        "auto": { "type": "boolean" }
      },
      "required": ["id", "type", "summary", "status", "source", "at", "refs", "author", "review"],
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the project root."
    },
    "deduplicated": {
      "type": "boolean",
      "description": "True when an equal entry existed: `entry` is that entry and nothing was written."
    },
    "downgraded": {
      "description": "Present when a verifier blocker outside the blocking categories was written as an observation (P8).",
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "blocker" },
        "category": { "type": ["string", "null"] }
      },
      "required": ["type", "category"],
      "additionalProperties": false
    }
  },
  "required": ["entry", "path", "deduplicated"],
  "additionalProperties": false,
  "examples": [
    {
      "entry": {
        "id": "L-e8k2s5vw",
        "type": "finding",
        "summary": "expired magic link still accepted",
        "status": "proposed",
        "source": "agent:implementer",
        "author": "Jan Kowalski <jan@example.com>",
        "at": "2026-09-25T10:15:02.640Z",
        "refs": ["src/auth/login.ts", "02-3"],
        "review": false,
        "ticket": "A-7f3kx2p9"
      },
      "path": ".bdk/changes/2026-09-25-passwordless-login/log/20260925T101502Z-finding-L-e8k2s5vw.md",
      "deduplicated": false
    }
  ]
}

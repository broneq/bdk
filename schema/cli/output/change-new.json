{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-new.json",
  "title": "bdk change new --json",
  "description": "Open a Change on the current branch from an intent; measure and propose the profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["change", "branch", "kind", "profile", "source", "next"],
  "properties": {
    "change": {
      "type": "string",
      "description": "Opaque merge-safe id (T14)."
    },
    "branch": {
      "type": "string"
    },
    "kind": {
      "enum": ["feature", "bug"]
    },
    "profile": {
      "type": "object",
      "required": ["value", "measured", "entry"],
      "properties": {
        "value": {
          "enum": ["tiny", "small", "large"]
        },
        "measured": {
          "enum": ["tiny", "small", "large"]
        },
        "overridden": {
          "type": "boolean"
        },
        "entry": {
          "type": "string",
          "description": "Opaque merge-safe id (T14)."
        }
      }
    },
    "source": {
      "enum": ["user", "inferred"]
    },
    "overriddenKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of keys the local layer overrides (D4b)."
    },
    "next": {
      "type": "string",
      "description": "First artifact id from the graph."
    }
  },
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "branch": "feat/login",
      "kind": "feature",
      "profile": {
        "value": "small",
        "measured": "small",
        "overridden": false,
        "entry": "L-m2x9v"
      },
      "source": "user",
      "overriddenKeys": ["policy.escalation.enabled"],
      "next": "design"
    }
  ]
}

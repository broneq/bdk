{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-new.json",
  "title": "bdk change new --json",
  "description": "Open a Change on the current branch from an intent and record its starting profile.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "branch": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["feature", "bug"] },
    "profile": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "enum": ["tiny", "small", "large"] },
        "defaulted": {
          "type": "boolean",
          "description": "True when the caller passed no --profile."
        },
        "entry": {
          "type": "string",
          "pattern": "^L-[0-9a-z]{8}$",
          "description": "The assumption entry recording the profile."
        }
      },
      "required": ["value", "defaulted", "entry"],
      "additionalProperties": false
    },
    "source": { "type": "string", "enum": ["user", "inferred"] },
    "overriddenKeys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keys the global or local layer sets (D4b), names only."
    },
    "next": {
      "description": "The next command; absent until the artifact graph lands (T21).",
      "type": "string"
    }
  },
  "required": ["change", "branch", "kind", "profile", "source", "overriddenKeys"],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "branch": "feat/login",
      "kind": "feature",
      "profile": { "value": "small", "defaulted": true, "entry": "L-8n4vq6hy" },
      "source": "user",
      "overriddenKeys": ["policy.escalation.enabled"]
    }
  ]
}

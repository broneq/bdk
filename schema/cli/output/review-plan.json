{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/review-plan.json",
  "title": "bdk review plan --json",
  "description": "Compute the range and the reviewer groups of the next review round of the active Change.",
  "type": "object",
  "properties": {
    "change": { "type": "string", "minLength": 1 },
    "anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["delta", "full", "base"],
          "description": "`delta`: the head of the latest merged review; `full`: the Change base; `base`: the merge base with `--base`."
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The anchor commit, or the empty tree for a Change opened by the root commit."
        }
      },
      "required": ["kind", "sha"],
      "additionalProperties": false
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The reviewed commit, `HEAD`."
    },
    "range": {
      "type": "string",
      "minLength": 1,
      "description": "`<anchor>..<head>`, committed history only."
    },
    "dirty": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Tracked files outside `.bdk/` with uncommitted changes; the groups leave them out."
    },
    "measure": {
      "type": "object",
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "added": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "removed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["files", "added", "removed", "modules"],
      "additionalProperties": false,
      "description": "The range's signals as `bdk measure` returns them."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "`p<nn>`, `unplanned`, `m<k>` or `integration`; a split group adds `-<k>`."
          },
          "kind": { "type": "string", "enum": ["part", "unplanned", "module", "integration"] },
          "part": {
            "description": "Only on a `part` group: the plan part number.",
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Sorted repository-relative paths."
          }
        },
        "required": ["id", "kind", "files"],
        "additionalProperties": false
      },
      "description": "Parts (or modules without a plan), `unplanned`, then `integration`; empty for an empty range."
    }
  },
  "required": ["change", "anchor", "head", "range", "dirty", "measure", "groups"],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "anchor": { "kind": "delta", "sha": "4f1c2d9a7b3e5f60718293a4b5c6d7e8f9a0b1c2" },
      "head": "9a8b7c6d5e4f30211203f4e5d6c7b8a9f0e1d2c3",
      "range": "4f1c2d9a7b3e5f60718293a4b5c6d7e8f9a0b1c2..9a8b7c6d5e4f30211203f4e5d6c7b8a9f0e1d2c3",
      "dirty": [],
      "measure": { "files": 3, "added": 120, "removed": 14, "modules": ["src/auth", "src/mail"] },
      "groups": [
        {
          "id": "p01",
          "kind": "part",
          "part": "01",
          "files": ["src/auth/login.test.ts", "src/auth/login.ts"]
        },
        { "id": "unplanned", "kind": "unplanned", "files": ["src/mail/send.ts"] },
        {
          "id": "integration",
          "kind": "integration",
          "files": ["src/auth/login.test.ts", "src/auth/login.ts", "src/mail/send.ts"]
        }
      ]
    }
  ]
}

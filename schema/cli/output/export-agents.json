{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/export-agents.json",
  "title": "bdk export agents --json",
  "description": "Generate a host's adapter files from the kernel's adapter definitions and the per-host tool map.",
  "type": "object",
  "properties": {
    "host": { "type": "string", "description": "The host the files were generated for." },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "enum": ["worker", "reader", "reviewer", "runner", "scout"]
          },
          "path": { "type": "string", "description": "Path relative to the project root." },
          "changed": {
            "type": "boolean",
            "description": "Written by this run, or found different under --check."
          }
        },
        "required": ["adapter", "path", "changed"],
        "additionalProperties": false
      }
    },
    "changed": { "type": "boolean", "description": "True when any file changed." }
  },
  "required": ["host", "files", "changed"],
  "additionalProperties": false,
  "examples": [
    {
      "host": "claude",
      "files": [{ "adapter": "worker", "path": "agents/worker.md", "changed": false }],
      "changed": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/agents-wait.json",
  "title": "bdk agents wait --json",
  "description": "What the calling agent must react to, or a timeout.",
  "type": "object",
  "properties": {
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "message" },
              "from": {
                "type": "string",
                "minLength": 1,
                "description": "The host's agent id, or `main`."
              },
              "entry": {
                "type": "string",
                "pattern": "^L-[0-9a-z]{8}$",
                "description": "The ledger entry the message points to."
              }
            },
            "required": ["kind", "from", "entry"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "report" },
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "The host's agent id, or `main`."
              },
              "ticket": {
                "type": "string",
                "pattern": "^A-[0-9a-z]{8}$",
                "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "description": "The envelope's `status`."
              }
            },
            "required": ["kind", "agent", "ticket", "status"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "ended" },
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "The host's agent id, or `main`."
              },
              "by": {
                "type": "string",
                "enum": ["subagent-stop", "task-stop", "agent-result", "stale"]
              }
            },
            "required": ["kind", "agent", "by"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "suspect" },
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "The host's agent id, or `main`."
              }
            },
            "required": ["kind", "agent"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "kind": { "type": "string", "const": "timeout" } },
            "required": ["kind"],
            "additionalProperties": false
          }
        ]
      }
    },
    "elapsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Seconds since the caller's start (T41-D8)."
    },
    "children": {
      "type": "object",
      "properties": {
        "starting": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "running": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "suspect": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ended": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["starting", "running", "suspect", "ended"],
      "additionalProperties": false,
      "description": "The caller's children in each state."
    }
  },
  "required": ["events", "elapsed", "children"],
  "additionalProperties": false,
  "examples": [
    {
      "events": [
        {
          "kind": "report",
          "agent": "a1b2c3d4e5f6a7b8c",
          "ticket": "A-9k2m4n6p",
          "status": "done"
        },
        { "kind": "message", "from": "a7c6b5d4e3f2a1b0c", "entry": "L-q7w2e9r4" }
      ],
      "elapsed": 344,
      "children": { "starting": 0, "running": 2, "suspect": 0, "ended": 1 }
    }
  ]
}

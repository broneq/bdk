{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-resolve.json",
  "title": "bdk log resolve --json",
  "description": "Set an entry's status (resolved, accepted, superseded) with a reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry", "status"],
  "properties": {
    "entry": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "status": {
      "enum": ["proposed", "accepted", "superseded", "resolved", "routed"]
    },
    "by": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "record": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "reason": {
      "type": "string"
    }
  },
  "examples": [
    {
      "entry": "L-e8k2s",
      "status": "resolved",
      "record": "L-e8k2s",
      "reason": "fixed in A-7f3k retry"
    }
  ]
}

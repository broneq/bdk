{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-resolve.json",
  "title": "bdk log resolve --json",
  "description": "Set an entry's status (resolved, accepted, superseded) with a reason.",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "status": { "type": "string", "enum": ["accepted", "resolved", "superseded"] },
    "by": {
      "description": "The superseding entry, for `superseded`.",
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$"
    },
    "record": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
      "description": "The rewritten entry: `entry`, or `by` for `superseded`."
    },
    "reason": { "type": "string" }
  },
  "required": ["entry", "status", "record"],
  "additionalProperties": false,
  "examples": [
    {
      "entry": "L-e8k2s5vw",
      "status": "resolved",
      "record": "L-e8k2s5vw",
      "reason": "fixed in A-7f3kx2p9 retry"
    }
  ]
}

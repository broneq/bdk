{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/hooks-prompt-expansion.json",
  "title": "bdk hooks prompt-expansion --json",
  "description": "UserPromptExpansion guard: the only writer of `source: user` stage transitions and the start of a run. A block is the error object under --json and <rule>: <why> on stderr otherwise.",
  "type": "object",
  "properties": {
    "decision": { "type": "string", "const": "pass" },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "The bare skill name parsed from the namespaced command_name (bdk:plan -> plan); the whole name outside the bdk: namespace."
    },
    "stage": {
      "description": "The pipeline stage the command names; absent for /bdk:run and other skills.",
      "type": "string",
      "minLength": 1
    },
    "gate": { "description": "The gate that opens the stage.", "type": "string", "minLength": 1 },
    "entry": {
      "description": "The transition written, if any.",
      "type": "string",
      "pattern": "^L-[0-9a-z]{8}$"
    },
    "wrote": {
      "type": "string",
      "enum": ["transition:user", "transition:policy", "transition:stage", "none"]
    },
    "skipVerify": {
      "description": "Whether the stage transition carries skip-verify (only /bdk:execute).",
      "type": "boolean"
    },
    "status": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1,
          "description": "Gate node id, e.g. gate:design."
        },
        "ready": { "type": "boolean" },
        "done": { "type": "boolean" },
        "passedBy": { "type": "string", "enum": ["user", "policy"] },
        "command": {
          "description": "The stage command the user types to pass it, e.g. /bdk:plan.",
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^L-[0-9a-z]{8}$",
                "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
              },
              "type": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "type", "summary"],
            "additionalProperties": false
          },
          "description": "review: true entries listed, never dispositioned."
        }
      },
      "required": ["gate", "ready", "done", "pending"],
      "additionalProperties": false,
      "description": "What the user sees before typing the next stage command (T1)."
    },
    "passedAt": {
      "description": "When the gate was passed, for a gate that was already done.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "passed": {
      "description": "/bdk:run: the ready auto gates passed by policy.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "entry": {
            "type": "string",
            "pattern": "^L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          }
        },
        "required": ["gate", "stage", "entry"],
        "additionalProperties": false
      }
    },
    "waiting": {
      "description": "/bdk:run: the ready manual gates the user still types.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1,
            "description": "Gate node id, e.g. gate:design."
          },
          "ready": { "type": "boolean" },
          "done": { "type": "boolean" },
          "passedBy": { "type": "string", "enum": ["user", "policy"] },
          "command": {
            "description": "The stage command the user types to pass it, e.g. /bdk:plan.",
            "type": "string"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^L-[0-9a-z]{8}$",
                  "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
                },
                "type": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "type", "summary"],
              "additionalProperties": false
            },
            "description": "review: true entries listed, never dispositioned."
          }
        },
        "required": ["gate", "ready", "done", "pending"],
        "additionalProperties": false,
        "description": "What the user sees before typing the next stage command (T1)."
      }
    },
    "run": {
      "description": "/bdk:run: the session's run marker was written (T41).",
      "type": "object",
      "properties": {
        "auto": { "type": "boolean", "description": "--auto was the first argument token." },
        "intent": { "type": "boolean", "description": "An intent followed the flags." }
      },
      "required": ["auto", "intent"],
      "additionalProperties": false
    }
  },
  "required": ["decision", "command", "wrote"],
  "additionalProperties": false,
  "examples": [
    {
      "decision": "pass",
      "command": "plan",
      "stage": "plan",
      "gate": "gate:design",
      "entry": "L-g5h2j7qa",
      "wrote": "transition:user",
      "skipVerify": false
    }
  ]
}

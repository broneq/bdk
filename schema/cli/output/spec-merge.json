{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/spec-merge.json",
  "title": "bdk spec merge --json",
  "description": "Deterministically merge the Change's deltas into `.bdk/specs/`; refuse on conflict.",
  "type": "object",
  "properties": {
    "merged": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "description": "The capability path, e.g. `auth/login`."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the project root."
          },
          "mergeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "added": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "ADDED requirements of the delta."
          },
          "modified": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "MODIFIED requirements plus REMOVED entries listing only scenarios."
          },
          "removed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Requirements REMOVED as a whole."
          }
        },
        "required": ["capability", "path", "mergeHash", "added", "modified", "removed"],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "description": "The capability path, e.g. `auth/login`."
          },
          "requirement": { "type": "string", "minLength": 1 },
          "ours": { "type": "string", "minLength": 1, "description": "This Change's block." },
          "theirs": {
            "type": "string",
            "minLength": 1,
            "description": "The archived Change's block, prefixed by its id and `: `."
          }
        },
        "required": ["capability", "requirement", "ours", "theirs"],
        "additionalProperties": false
      },
      "description": "Listed by `--dry-run`; without it a conflict refuses."
    }
  },
  "required": ["merged", "conflicts"],
  "additionalProperties": false,
  "examples": [
    {
      "merged": [
        {
          "capability": "auth/login",
          "path": ".bdk/specs/auth/login/spec.md",
          "mergeHash": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
          "added": 2,
          "modified": 1,
          "removed": 0
        }
      ],
      "conflicts": []
    }
  ]
}

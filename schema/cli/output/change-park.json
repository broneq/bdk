{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-park.json",
  "title": "bdk change park --json",
  "description": "Park the active Change with a question or blocker entry, options and one resume command.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "entry": {
      "type": "string",
      "pattern": "^L-[0-9a-z]{8}$",
      "description": "The park question."
    },
    "options": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resume": { "type": "string" },
    "checkpoint": {
      "type": "object",
      "properties": {
        "done": { "type": "boolean" },
        "commit": {
          "description": "The checkpoint commit, abbreviated; present when done.",
          "type": "string",
          "pattern": "^[0-9a-f]{7}$"
        },
        "skipped": {
          "description": "Why no checkpoint commit was made; present when not done.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["done"],
      "additionalProperties": false,
      "description": "The checkpoint of the Change directory (`kernel-loops`, Checkpoint)."
    }
  },
  "required": ["change", "entry", "options", "resume", "checkpoint"],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "entry": "L-t4w7n3kd",
      "options": ["accept as debt", "split part 02"],
      "resume": "bdk change resume 2026-09-25-passwordless-login --option <n>",
      "checkpoint": { "done": true, "commit": "a1b2c3d" }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-import.json",
  "title": "bdk rules import --json",
  "description": "Import a project's `.claude/rules/*.md` into `.bdk/rules/` with ids and applies from paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["imported", "skipped"],
  "properties": {
    "imported": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "rules"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Path relative to the project root."
          },
          "to": {
            "type": "string",
            "description": "Path relative to the project root."
          },
          "rules": {
            "type": "integer"
          },
          "prefix": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "why"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Path relative to the project root."
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "imported": [
        {
          "from": ".claude/rules/fragment-system.md",
          "to": ".bdk/rules/fragment-system.md",
          "rules": 6,
          "prefix": "FRAG"
        }
      ],
      "skipped": [
        {
          "from": ".claude/rules/bdk-generated.md",
          "why": "generated by rules export"
        }
      ]
    }
  ]
}

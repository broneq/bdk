{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-import.json",
  "title": "bdk rules import --json",
  "description": "Import a project's `.claude/rules/*.md` into `.bdk/rules/`, one rule per top-level bullet, applies from paths.",
  "type": "object",
  "properties": {
    "imported": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the project root."
          },
          "rules": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[1-9][0-9]*$"
            }
          },
          "applies": {
            "description": "The file's `paths:`; absent: global rules.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["from", "rules"],
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the project root."
          },
          "why": { "type": "string", "minLength": 1 }
        },
        "required": ["from", "why"],
        "additionalProperties": false
      }
    },
    "dryRun": { "type": "boolean", "description": "True with --dry-run: nothing was written." },
    "projection": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "description": "Relative to the project root." },
      "description": "The projection files the import rewrote or deleted."
    }
  },
  "required": ["imported", "skipped", "dryRun", "projection"],
  "additionalProperties": false,
  "examples": [
    {
      "imported": [
        {
          "from": ".claude/rules/api-style.md",
          "rules": ["API-STYLE-1", "API-STYLE-2"],
          "applies": ["src/api/**"]
        }
      ],
      "skipped": [{ "from": ".claude/rules/bdk-generated.md", "why": "generated by rules export" }],
      "dryRun": false,
      "projection": [".claude/rules/bdk-generated-scoped.md"]
    }
  ]
}

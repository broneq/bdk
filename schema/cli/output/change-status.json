{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-status.json",
  "title": "bdk change status --json",
  "description": "The active Change at a glance: stage, graph state, gate status with pending review entries, parked options.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "kind": { "type": "string", "enum": ["feature", "bug"] },
    "profile": {
      "type": "string",
      "enum": ["tiny", "small", "large"],
      "description": "The effective profile (`kernel-state`, Derived state)."
    },
    "source": { "type": "string", "enum": ["user", "inferred"] },
    "confirmed": {
      "type": "boolean",
      "description": "False while an inferred Change has no transition with source user."
    },
    "stage": { "type": "string", "minLength": 1 },
    "parked": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^L-[0-9a-z]{8}$",
          "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
        },
        "options": { "type": "array", "items": { "type": "string" } },
        "resume": { "type": "string", "description": "The single resume command." }
      },
      "required": ["entry", "options", "resume"],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Artifact kind from pipeline.yaml (T21)."
          },
          "state": { "type": "string", "enum": ["blocked", "ready", "done", "stale", "skipped"] },
          "requires": { "type": "array", "items": { "type": "string" } },
          "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "why": {
            "description": "For blocked and stale: what is missing or what changed.",
            "type": "string"
          }
        },
        "required": ["id", "kind", "state"],
        "additionalProperties": false
      },
      "description": "Empty until the artifact graph lands (T21)."
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1,
            "description": "Gate node id, e.g. gate:design."
          },
          "ready": { "type": "boolean" },
          "done": { "type": "boolean" },
          "passedBy": { "type": "string", "enum": ["user", "policy"] },
          "command": {
            "description": "The stage command the user types to pass it, e.g. /bdk:plan.",
            "type": "string"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^L-[0-9a-z]{8}$",
                  "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "decision",
                    "finding",
                    "observation",
                    "blocker",
                    "question",
                    "assumption",
                    "risk",
                    "learning",
                    "report",
                    "transition"
                  ]
                },
                "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
                "status": {
                  "type": "string",
                  "enum": ["proposed", "accepted", "superseded", "resolved", "routed"]
                },
                "source": {
                  "type": "string",
                  "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$"
                },
                "author": { "type": "string" },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
                  "description": "ISO 8601 UTC with milliseconds."
                },
                "refs": { "minItems": 1, "type": "array", "items": { "type": "string" } },
                "review": { "type": "boolean" },
                "supersedes": {
                  "type": "string",
                  "pattern": "^L-[0-9a-z]{8}$",
                  "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
                }
              },
              "required": ["id", "type", "summary", "status", "source", "at", "refs"],
              "additionalProperties": false
            },
            "description": "review: true entries listed, never dispositioned."
          }
        },
        "required": ["gate", "ready", "done", "pending"],
        "additionalProperties": false,
        "description": "What the user sees before typing the next stage command (T1)."
      },
      "description": "Empty until the artifact graph lands (T21)."
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": { "type": "string", "pattern": "^\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["blocked", "ready", "started", "done", "stale"] },
          "tasks": { "type": "integer", "minimum": 0, "maximum": 8 },
          "done": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 8192 },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "specImpact": { "type": "string", "enum": ["none", "delta"] },
          "wave": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "required": ["part", "title", "state", "tasks", "bytes"],
        "additionalProperties": false
      },
      "description": "Empty until plan parts land (T22)."
    },
    "openTickets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket": { "type": "string" },
          "loop": { "type": "string" },
          "target": { "type": "string" },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "of": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "scope": { "type": "string", "enum": ["full", "high+", "blockers"] },
          "openedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
            "description": "ISO 8601 UTC with milliseconds."
          }
        },
        "required": ["ticket", "loop", "target", "attempt", "of", "scope", "openedAt"],
        "additionalProperties": false
      }
    },
    "overriddenKeys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keys the global or local layer sets (D4b), names only."
    }
  },
  "required": [
    "change",
    "kind",
    "profile",
    "source",
    "confirmed",
    "stage",
    "nodes",
    "gates",
    "parts",
    "openTickets",
    "overriddenKeys"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "kind": "feature",
      "profile": "large",
      "source": "user",
      "confirmed": true,
      "stage": "design",
      "nodes": [
        { "id": "design", "kind": "design", "state": "done" },
        { "id": "gate:design", "kind": "gate", "state": "ready" }
      ],
      "gates": [
        {
          "gate": "gate:design",
          "ready": true,
          "done": false,
          "command": "/bdk:plan",
          "pending": [
            {
              "id": "L-k3d8p2xq",
              "type": "question",
              "summary": "Keep magic links or add WebAuthn?",
              "status": "proposed",
              "source": "agent:design-verifier",
              "at": "2026-09-25T09:41:07.123Z",
              "refs": ["design.md"],
              "review": true
            }
          ]
        }
      ],
      "parts": [],
      "openTickets": [],
      "overriddenKeys": ["policy.escalation.enabled"]
    }
  ]
}

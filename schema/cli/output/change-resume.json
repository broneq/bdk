{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-resume.json",
  "title": "bdk change resume --json",
  "description": "Bind an existing Change to the current branch or leave the parked state with a chosen option.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "branch": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "resumedFrom": { "type": "string", "enum": ["parked", "other-branch", "other-machine"] },
    "decision": {
      "description": "The decision entry written: the chosen option, else the raised profile.",
      "type": "string",
      "pattern": "^L-[0-9a-z]{8}$"
    },
    "next": {
      "description": "The next command; absent until the artifact graph lands (T21).",
      "type": "string"
    }
  },
  "required": ["change", "branch", "stage"],
  "additionalProperties": false,
  "examples": [
    {
      "change": "2026-09-25-passwordless-login",
      "branch": "feat/login",
      "stage": "execute",
      "resumedFrom": "parked",
      "decision": "L-p9q2r4tx"
    }
  ]
}

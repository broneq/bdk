{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-show.json",
  "title": "bdk rules show --json",
  "description": "Print one rule by id, or the rules of a ticket.",
  "type": "object",
  "properties": {
    "ticket": { "type": "string", "pattern": "^A-[0-9a-z]{8}$" },
    "role": {
      "type": "string",
      "enum": [
        "implementer",
        "simplifier",
        "verifier",
        "design-verifier",
        "reviewer",
        "pr-reviewer",
        "runner",
        "scout"
      ]
    },
    "target": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^rules\\/", "description": "The prompt key." },
          "file": {
            "type": "string",
            "description": "The plugin file of the default, relative to the plugin root; else the lowest file."
          },
          "layers": {
            "type": "array",
            "items": { "type": "string", "enum": ["default", "global", "project", "local"] },
            "description": "The layers whose files form the value, lowest first."
          },
          "text": { "type": "string", "description": "The resolved prompt value." }
        },
        "required": ["key", "file", "layers", "text"],
        "additionalProperties": false
      },
      "description": "The role's rule categories, then the language rules, in order."
    },
    "rulesRead": {
      "description": "The `rules-read` stamp of the attempt record: the time of the implementer's first call for the ticket; absent until then.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": ["ticket", "role", "target", "sections"],
  "additionalProperties": false,
  "examples": [
    {
      "ticket": "A-7f3k9m2q",
      "role": "implementer",
      "target": "02-3",
      "sections": [
        {
          "key": "rules/code-quality",
          "file": "rules/code-quality.md",
          "layers": ["default"],
          "text": "# Code Quality Rules\n..."
        },
        {
          "key": "rules/languages/typescript",
          "file": "rules/languages/typescript.md",
          "layers": ["default", "project"],
          "text": "# TypeScript\n..."
        }
      ],
      "rulesRead": "2026-09-25T10:00:41.305Z"
    }
  ]
}

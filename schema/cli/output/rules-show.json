{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/rules-show.json",
  "title": "bdk rules show --json",
  "description": "Print one rule by id, or the rules of a ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket", "role", "target", "sections", "rulesRead"],
  "properties": {
    "ticket": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "role": {
      "enum": [
        "implementer",
        "verifier",
        "design-verifier",
        "reviewer",
        "pr-reviewer",
        "runner",
        "scout"
      ]
    },
    "target": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "description": "The role's rule categories, then the language rules, in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "file", "layers", "text"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^rules/"
          },
          "file": {
            "type": "string",
            "description": "The plugin file of the default, relative to the plugin root."
          },
          "layers": {
            "type": "array",
            "items": {
              "enum": ["default", "global", "project", "local"]
            }
          },
          "text": {
            "type": "string",
            "description": "The resolved prompt value."
          }
        }
      }
    },
    "rulesRead": {
      "type": "string",
      "format": "date-time",
      "description": "The `rules-read` stamp of the attempt record: the time of the first call for the ticket."
    }
  },
  "examples": [
    {
      "ticket": "A-7f3k9m2q",
      "role": "implementer",
      "target": "02-3",
      "sections": [
        {
          "key": "rules/code-quality",
          "file": "rules/code-quality.md",
          "layers": ["default"],
          "text": "# Code Quality Rules\n..."
        },
        {
          "key": "rules/languages/typescript",
          "file": "rules/languages/typescript.md",
          "layers": ["default", "project"],
          "text": "# TypeScript\n..."
        }
      ],
      "rulesRead": "2026-09-25T10:00:41Z"
    }
  ]
}

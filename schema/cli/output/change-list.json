{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-list.json",
  "title": "bdk change list --json",
  "description": "List Changes in this repository: active per branch, parked, archived.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "branch": {
            "description": "The local branch bound to the Change; absent when no marker binds it.",
            "type": "string"
          },
          "stage": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["active", "parked", "archived"] },
          "kind": { "type": "string", "enum": ["feature", "bug"] },
          "profile": { "type": "string", "enum": ["tiny", "small", "large"] },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
            "description": "ISO 8601 UTC with milliseconds."
          }
        },
        "required": ["change", "stage", "state", "kind", "profile", "updatedAt"],
        "additionalProperties": false
      }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "truncated": { "type": "boolean" }
  },
  "required": ["items", "total", "truncated"],
  "additionalProperties": false,
  "examples": [
    {
      "items": [
        {
          "change": "2026-09-25-passwordless-login",
          "branch": "feat/login",
          "stage": "design",
          "state": "active",
          "kind": "feature",
          "profile": "small",
          "updatedAt": "2026-09-25T09:41:07.123Z"
        }
      ],
      "total": 1,
      "truncated": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-ingest.json",
  "title": "bdk log ingest --json",
  "description": "Store a role's report under its ticket.",
  "type": "object",
  "properties": {
    "ticket": { "type": "string", "pattern": "^A-[0-9a-z]{8}$" },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "The role of the ticket's dispatch package."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "The package's `report` path from the project root, where the report is stored."
    },
    "status": {
      "type": "string",
      "enum": ["done", "done-with-concerns", "needs-context", "blocked"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
        "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
      },
      "description": "The envelope's entry ids, each written under the ticket."
    },
    "replaced": {
      "type": "boolean",
      "description": "True when an earlier report of the same open ticket was replaced."
    }
  },
  "required": ["ticket", "role", "path", "status", "entries", "replaced"],
  "additionalProperties": false,
  "examples": [
    {
      "ticket": "A-9c2d4f6h",
      "role": "verifier",
      "path": ".bdk/changes/2026-09-25-passwordless-login/reports/02-verifier-A-9c2d4f6h.md",
      "status": "done-with-concerns",
      "entries": ["L-w4m1q7ra"],
      "replaced": false
    }
  ]
}

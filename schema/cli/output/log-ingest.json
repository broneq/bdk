{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/log-ingest.json",
  "title": "bdk log ingest --json",
  "description": "Ingest a `bdk-entries` block from a read-only role's report under its ticket.",
  "type": "object",
  "properties": {
    "ticket": { "type": "string", "pattern": "^A-[0-9a-z]{8}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "finding",
              "observation",
              "blocker",
              "question",
              "assumption",
              "risk",
              "learning",
              "report",
              "transition"
            ]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": {
            "type": "string",
            "enum": ["proposed", "accepted", "superseded", "resolved", "routed"],
            "description": "Derived: `superseded` when another entry names this one in `supersedes`."
          },
          "source": {
            "type": "string",
            "pattern": "^(user|policy|inferred|kernel|agent:[a-z][a-z0-9-]*)$",
            "description": "Who produced the entry (P1); stamped by the kernel."
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "ISO 8601 UTC with seconds."
          },
          "refs": { "minItems": 1, "type": "array", "items": { "type": "string", "minLength": 1 } },
          "author": { "type": "string", "minLength": 1 },
          "review": { "type": "boolean" },
          "ticket": { "type": "string" },
          "supersedes": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "fingerprint": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "park": { "type": "boolean" },
          "profile": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "applies": { "type": "array", "items": { "type": "string" } },
          "routedTo": { "type": "string" },
          "report": { "type": "string" },
          "to": { "type": "string" },
          "gate": { "type": "string" },
          "session": { "type": "string" },
          "command": { "type": "string" },
          "skipVerify": { "type": "boolean" }
        },
        "required": ["id", "type", "summary", "status", "source", "at", "refs", "author", "review"],
        "additionalProperties": false
      },
      "description": "The block's entries in order; an entry equal to a live one of the ticket is that entry, not written again."
    },
    "downgraded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+\\/)?L-[0-9a-z]{8}$",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          },
          "originalCategory": { "type": "string" }
        },
        "required": ["entry", "originalCategory"],
        "additionalProperties": false
      },
      "description": "Blockers without a category from the closed list, stored as observation with review: true (P8; from T23)."
    }
  },
  "required": ["ticket", "entries", "downgraded"],
  "additionalProperties": false,
  "examples": [
    {
      "ticket": "A-9c2d4f6h",
      "entries": [
        {
          "id": "L-w4m1q7ra",
          "type": "blocker",
          "summary": "plan claims verifyToken exists; it does not",
          "status": "proposed",
          "source": "agent:plan-verifier",
          "author": "Jan Kowalski <jan@example.com>",
          "at": "2026-09-25T10:31:44Z",
          "refs": ["plan/parts/02-login.md", "src/auth/token.ts"],
          "review": false,
          "ticket": "A-9c2d4f6h"
        }
      ],
      "downgraded": []
    }
  ]
}

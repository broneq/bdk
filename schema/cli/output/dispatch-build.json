{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/dispatch-build.json",
  "title": "bdk dispatch build --json",
  "description": "Build the dispatch package file for a target, role and ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "bytes",
    "ticket",
    "target",
    "role",
    "adapter",
    "kernelVersion",
    "templateHash",
    "report",
    "entries"
  ],
  "properties": {
    "path": {
      "type": "string",
      "description": "Path relative to the project root."
    },
    "bytes": {
      "type": "integer",
      "maximum": 12288
    },
    "ticket": {
      "type": "string",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "target": {
      "type": "string",
      "description": "The ticket's target: a task id, a part id, the Change id or an artifact id."
    },
    "role": {
      "enum": [
        "implementer",
        "verifier",
        "design-verifier",
        "reviewer",
        "pr-reviewer",
        "runner",
        "scout"
      ]
    },
    "adapter": {
      "enum": ["worker", "reader", "reviewer", "runner", "scout"]
    },
    "scope": {
      "enum": ["full", "high+", "blockers"]
    },
    "kernelVersion": {
      "type": "string"
    },
    "templateHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "report": {
      "type": "string",
      "description": "Path relative to the project root where `bdk log ingest --ticket` stores the report."
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "counted"],
      "properties": {
        "full": {
          "type": "array",
          "description": "Accepted decisions and unresolved blockers of the target, embedded in full.",
          "items": {
            "type": "string",
            "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
          }
        },
        "counted": {
          "type": "object",
          "description": "Per-type counts of the other entries of the target, listed by `bdk log list --for <target>`.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "path": ".bdk/changes/2026-09-25-passwordless-login/dispatch/02-3-implementer-A-7f3k9m2q.md",
      "bytes": 9814,
      "ticket": "A-7f3k9m2q",
      "target": "02-3",
      "role": "implementer",
      "adapter": "worker",
      "scope": "high+",
      "kernelVersion": "3.0.0",
      "templateHash": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "report": ".bdk/changes/2026-09-25-passwordless-login/reports/02-3-implementer-A-7f3k9m2q.md",
      "entries": {
        "full": ["L-a2s5d7k1"],
        "counted": {
          "finding": 2,
          "observation": 1
        }
      }
    }
  ]
}

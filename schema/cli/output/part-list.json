{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/part-list.json",
  "title": "bdk part list --json",
  "description": "Plan parts with state, task counts, size, dependencies and wave.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": { "type": "string", "pattern": "^\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "state": {
            "type": "string",
            "enum": ["blocked", "ready", "started", "done", "stale"],
            "description": "The `execute-part` node state; `ready` shows as `started` once `part start` ran."
          },
          "tasks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "done": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Tasks with a trailer commit reachable from HEAD."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Size of the part file; an oversized part is listed, not hidden."
          },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^\\d{2}$" } },
          "specImpact": { "type": "string", "enum": ["none", "delta"] },
          "wave": {
            "description": "From the plan index rule; absent when the dependencies form no plan.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["part", "title", "state", "tasks", "done", "bytes", "specImpact"],
        "additionalProperties": false
      }
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "truncated": { "type": "boolean" }
  },
  "required": ["items", "total", "truncated"],
  "additionalProperties": false,
  "examples": [
    {
      "items": [
        {
          "part": "01",
          "title": "Token service",
          "state": "done",
          "tasks": 4,
          "done": 4,
          "bytes": 5120,
          "specImpact": "delta",
          "wave": 1
        },
        {
          "part": "02",
          "title": "Login endpoint",
          "state": "started",
          "tasks": 3,
          "done": 1,
          "bytes": 4210,
          "dependsOn": ["01"],
          "specImpact": "none",
          "wave": 2
        }
      ],
      "total": 2,
      "truncated": false
    }
  ]
}

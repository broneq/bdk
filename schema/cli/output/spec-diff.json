{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/spec-diff.json",
  "title": "bdk spec diff --json",
  "description": "What the merged spec would look like: requirement-level diff of the Change's deltas against `.bdk/specs/`.",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "description": "The capability path, e.g. `auth/login`."
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "change": {
                  "type": "string",
                  "enum": ["added", "modified", "removed"],
                  "description": "`modified` covers a REMOVED entry listing only scenarios."
                },
                "scenarios": {
                  "type": "object",
                  "properties": {
                    "added": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "removed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                  },
                  "required": ["added", "removed"],
                  "additionalProperties": false
                }
              },
              "required": ["name", "change", "scenarios"],
              "additionalProperties": false
            }
          }
        },
        "required": ["capability", "requirements"],
        "additionalProperties": false
      }
    }
  },
  "required": ["capabilities"],
  "additionalProperties": false,
  "examples": [
    {
      "capabilities": [
        {
          "capability": "auth/login",
          "requirements": [
            {
              "name": "Magic link expires",
              "change": "added",
              "scenarios": { "added": 2, "removed": 0 }
            }
          ]
        }
      ]
    }
  ]
}

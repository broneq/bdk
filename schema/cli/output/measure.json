{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/measure.json",
  "title": "bdk measure --json",
  "description": "Measure a git diff: changed files, lines and modules, as raw signals for the caller's own classification.",
  "type": "object",
  "properties": {
    "range": {
      "type": "string",
      "minLength": 1,
      "description": "The measured range, `HEAD` by default."
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Changed files, `.bdk/` excluded."
    },
    "added": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "removed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "added + removed; a binary file counts zero lines."
    },
    "modules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Distinct first two directory segments (the file name for a root file), sorted."
    }
  },
  "required": ["range", "files", "added", "removed", "lines", "modules"],
  "additionalProperties": false,
  "examples": [
    {
      "range": "main",
      "files": 6,
      "added": 180,
      "removed": 42,
      "lines": 222,
      "modules": ["src/auth", "src/mail"]
    }
  ]
}

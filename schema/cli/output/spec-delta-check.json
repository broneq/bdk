{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/spec-delta-check.json",
  "title": "bdk spec delta check --json",
  "description": "Validate a spec delta: Scenario prefix, WHEN / THEN, no silent scenario loss.",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean",
      "const": true,
      "description": "Always true: a delta with a problem refuses with `policy/spec-invalid`."
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "description": "The capability path, e.g. `auth/login`."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the project root."
          },
          "valid": { "type": "boolean" },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "1-based line in the delta."
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "scenario-prefix",
                    "when-missing",
                    "then-missing",
                    "scenario-lost",
                    "normative-word",
                    "requirement-unknown",
                    "requirement-exists",
                    "requirement-duplicate",
                    "scenario-missing",
                    "section-unknown",
                    "purpose-missing",
                    "delta-empty"
                  ]
                },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["line", "code", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["capability", "path", "valid", "problems"],
        "additionalProperties": false
      }
    }
  },
  "required": ["valid", "deltas"],
  "additionalProperties": false,
  "examples": [
    {
      "valid": true,
      "deltas": [
        {
          "capability": "auth/login",
          "path": ".bdk/changes/2026-09-25-passwordless-login/spec-delta/auth/login.md",
          "valid": true,
          "problems": []
        }
      ]
    }
  ]
}

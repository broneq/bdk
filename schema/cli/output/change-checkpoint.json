{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/change-checkpoint.json",
  "title": "bdk change checkpoint --json",
  "description": "Pathspec commit of the Change directory: `chore(bdk): checkpoint <change>`.",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
    },
    "done": { "type": "boolean" },
    "commit": {
      "description": "The checkpoint commit, abbreviated; present when done.",
      "type": "string",
      "pattern": "^[0-9a-f]{7}$"
    },
    "skipped": {
      "description": "Why no checkpoint commit was made; present when not done.",
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["change", "done"],
  "additionalProperties": false,
  "examples": [{ "change": "2026-09-25-passwordless-login", "done": true, "commit": "a1b2c3d" }]
}

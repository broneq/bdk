{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/cli/output/agents-show.json",
  "title": "bdk agents show --json",
  "description": "One agent of the registry with its lifecycle signals and children.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "The host's agent id, or `main`." },
    "type": { "description": "The host's `agent_type`.", "type": ["string", "null"] },
    "state": {
      "type": "string",
      "enum": ["starting", "running", "suspect", "ended"],
      "description": "Derived at the time of the call (`kernel-state`, Agent registry)."
    },
    "parent": {
      "anyOf": [
        { "type": "string", "minLength": 1, "description": "The host's agent id, or `main`." },
        { "type": "null" }
      ],
      "description": "null until the parent's spawn is linked."
    },
    "session": { "type": ["string", "null"] },
    "package": {
      "description": "The dispatch package, relative to the project root.",
      "type": ["string", "null"]
    },
    "ticket": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^A-[0-9a-z]{8}$",
          "description": "Opaque merge-safe id (`kernel-state`, Identifiers)."
        },
        { "type": "null" }
      ]
    },
    "target": { "type": ["string", "null"] },
    "startedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        { "type": "null" }
      ]
    },
    "lastSeenAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        { "type": "null" }
      ],
      "description": "The later of the last heartbeat and the start."
    },
    "linkedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        { "type": "null" }
      ]
    },
    "openCallSince": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        { "type": "null" }
      ],
      "description": "When the open tool call began; null without one."
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "ISO 8601 UTC with milliseconds."
        },
        { "type": "null" }
      ]
    },
    "endedBy": {
      "anyOf": [
        { "type": "string", "enum": ["subagent-stop", "task-stop", "agent-result", "stale"] },
        { "type": "null" }
      ]
    },
    "continuations": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The host's agent id, or `main`."
          },
          "type": { "type": ["string", "null"] },
          "state": {
            "type": "string",
            "enum": ["starting", "running", "suspect", "ended"],
            "description": "Derived at the time of the call (`kernel-state`, Agent registry)."
          },
          "target": { "type": ["string", "null"] }
        },
        "required": ["id", "type", "state", "target"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "type",
    "state",
    "parent",
    "session",
    "package",
    "ticket",
    "target",
    "startedAt",
    "lastSeenAt",
    "linkedAt",
    "openCallSince",
    "endedAt",
    "endedBy",
    "continuations",
    "children"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "id": "a9f8e7d6c5b4a3f2e",
      "type": "bdk:lead",
      "state": "running",
      "parent": "main",
      "session": "5d1c9e0a-2b7f-4c3e-9a61-0f2d8b7c4e11",
      "package": ".bdk/changes/2026-09-25-login/dispatch/02-lead-A-3h5j7k9m.md",
      "ticket": "A-3h5j7k9m",
      "target": "02",
      "startedAt": "2026-09-30T10:13:58.004Z",
      "lastSeenAt": "2026-09-30T10:20:01.377Z",
      "linkedAt": "2026-09-30T10:13:57.861Z",
      "openCallSince": "2026-09-30T10:19:02.110Z",
      "endedAt": null,
      "endedBy": null,
      "continuations": 0,
      "children": [
        { "id": "a1b2c3d4e5f6a7b8c", "type": "bdk:worker", "state": "running", "target": "02-4" }
      ]
    }
  ]
}

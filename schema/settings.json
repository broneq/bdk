{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/broneq/bdk/v3/schema/settings.json",
  "title": "BDK settings",
  "description": "One layer of the BDK settings: ~/.config/bdk/settings.yaml, .bdk/settings.yaml or .bdk/settings.local.yaml.",
  "type": "object",
  "properties": {
    "languages": {
      "default": [],
      "description": "Languages and frameworks of the project; a name selects the bundle's pack rules/languages/<name>/.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "rules": {
      "description": "Rule selection per dispatch package and the audit view of rules stats.",
      "default": {},
      "type": "object",
      "properties": {
        "warn-above": {
          "default": 100,
          "description": "Rules one role may read before hooks session-start warns; no cap, every applying rule reaches the agent.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "disabled": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[1-9][0-9]*$"
          },
          "uniqueItems": true,
          "description": "Rule ids switched off, BDK ones included."
        },
        "audit": {
          "default": {},
          "type": "object",
          "properties": {
            "min-changes": {
              "default": 3,
              "description": "Distinct Changes an item must appear in to be listed as recurring.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "prune": {
          "default": {},
          "type": "object",
          "properties": {
            "uncited-changes": {
              "default": 20,
              "description": "Recent Changes rules prune looks back for citations.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "description": "The commands the project runs, one entry per command, merged by id.",
      "default": {},
      "type": "object",
      "properties": {
        "test": {
          "default": [],
          "description": "Test commands; tier fast or e2e.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "Unique within the array; the merge key and the path segment."
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "The full, unscoped command."
              },
              "scoped": {
                "description": "The command for given paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "related": {
                "description": "The command for the tests covering given source paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "failed": {
                "description": "Re-run of the previous failures.",
                "type": "string",
                "minLength": 1
              },
              "incremental": {
                "description": "The incremental form.",
                "type": "string",
                "minLength": 1
              },
              "when": {
                "description": "When this entry is the right one to run; passed to the model as is.",
                "type": "string",
                "minLength": 1
              },
              "tier": { "type": "string", "enum": ["fast", "e2e"] }
            },
            "required": ["id", "command", "tier"],
            "additionalProperties": false,
            "title": "tool entry"
          }
        },
        "lint": {
          "default": [],
          "description": "Lint, format and type check commands.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "Unique within the array; the merge key and the path segment."
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "The full, unscoped command."
              },
              "scoped": {
                "description": "The command for given paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "related": {
                "description": "The command for the tests covering given source paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "failed": {
                "description": "Re-run of the previous failures.",
                "type": "string",
                "minLength": 1
              },
              "incremental": {
                "description": "The incremental form.",
                "type": "string",
                "minLength": 1
              },
              "when": {
                "description": "When this entry is the right one to run; passed to the model as is.",
                "type": "string",
                "minLength": 1
              },
              "tier": { "type": "string", "enum": ["lint", "format", "typecheck"] }
            },
            "required": ["id", "command", "tier"],
            "additionalProperties": false,
            "title": "tool entry"
          }
        },
        "build": {
          "default": [],
          "description": "Build commands; no tier.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "Unique within the array; the merge key and the path segment."
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "The full, unscoped command."
              },
              "scoped": {
                "description": "The command for given paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "related": {
                "description": "The command for the tests covering given source paths ({files}).",
                "type": "string",
                "minLength": 1,
                "pattern": "\\{files\\}"
              },
              "failed": {
                "description": "Re-run of the previous failures.",
                "type": "string",
                "minLength": 1
              },
              "incremental": {
                "description": "The incremental form.",
                "type": "string",
                "minLength": 1
              },
              "when": {
                "description": "When this entry is the right one to run; passed to the model as is.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "command"],
            "additionalProperties": false,
            "title": "tool entry"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "description": "Feature switches.",
      "default": {},
      "type": "object",
      "properties": {
        "lavish": {
          "default": true,
          "description": "Review in Lavish; false falls back to AskUserQuestion (R-11).",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "description": "How the orchestrator runs the dispatches of one wave.",
      "default": {},
      "type": "object",
      "properties": {
        "concurrency": {
          "default": 5,
          "description": "The most dispatches of one wave run at once; the swarm skill's context states it (T23-D52).",
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "description": "Composed of policy.gates, policy.budgets, policy.oscillation, policy.escalation, policy.verifier, policy.evidence, policy.checkpoint.",
      "default": {},
      "type": "object",
      "properties": {
        "gates": {
          "description": "How the pipeline proceeds: whether each human gate waits for the user.",
          "default": {},
          "type": "object",
          "properties": {
            "design": {
              "default": "manual",
              "description": "auto lets a policy transition pass gate:design.",
              "type": "string",
              "enum": ["manual", "auto"]
            },
            "review": {
              "default": "manual",
              "description": "auto lets a policy transition pass gate:review.",
              "type": "string",
              "enum": ["manual", "auto"]
            }
          },
          "additionalProperties": false
        },
        "budgets": {
          "description": "How many tickets each loop may open in one round before the ladder moves on.",
          "default": {},
          "type": "object",
          "properties": {
            "task-redispatch": {
              "default": 3,
              "description": "Re-dispatches of one task.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "verify-fix": {
              "default": 2,
              "description": "Fix rounds after a failed verification of one part.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "review-fix": {
              "default": 2,
              "description": "Fix rounds after the review of the Change.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "verifier": {
              "default": 2,
              "description": "Iterations of one verifier over one artifact.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "not-run": {
              "default": 3,
              "description": "Consecutive not-run closes of one loop and target.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "oscillation": {
          "description": "When a finding that keeps coming back shortens the ladder.",
          "default": {},
          "type": "object",
          "properties": {
            "threshold": {
              "default": 2,
              "description": "Fail records of one round that carry the same fingerprint.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "escalation": {
          "description": "The one-shot escalation ticket with a fresh context and a stronger model.",
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "false skips the escalation rung.",
              "type": "boolean"
            },
            "model": {
              "default": "opus",
              "description": "The model class the escalation ticket names; the dispatch adapter maps it.",
              "type": "string",
              "minLength": 1
            },
            "per-change": {
              "default": 3,
              "description": "Escalation tickets one Change may open in total.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "verifier": {
          "description": "What a verifier may block on (P8): a blocker outside blocking-categories is downgraded to a reviewed observation.",
          "default": {},
          "type": "object",
          "properties": {
            "blocking-categories": {
              "default": [
                {
                  "id": "architecture",
                  "description": "Materially invalid architecture, or a contradiction with an accepted decision."
                },
                { "id": "security", "description": "A security, privacy or authentication risk." },
                {
                  "id": "irreversible-step",
                  "description": "An irreversible or high-cost step without justification, such as a migration or data loss."
                },
                {
                  "id": "integration-failure",
                  "description": "A critical integration, data, rollout or rollback failure."
                },
                {
                  "id": "unresolved-decision",
                  "description": "An execution-critical unresolved decision or omitted requirement."
                },
                {
                  "id": "false-code-claim",
                  "description": "A claim about the real code that is false."
                }
              ],
              "description": "Merged by id; the default items always stay.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "description": "Unique within the array; the merge key."
                  },
                  "description": { "type": "string", "minLength": 1 }
                },
                "required": ["id", "description"],
                "additionalProperties": false,
                "title": "category entry",
                "description": "A category a verifier or design-verifier blocker may name."
              }
            },
            "not-a-fail": {
              "default": [
                { "id": "style", "description": "Style." },
                { "id": "template-conformance", "description": "Template conformance." },
                { "id": "files-bookkeeping", "description": "`Files:` bookkeeping." },
                { "id": "wording", "description": "Wording." },
                { "id": "report-length", "description": "Report length." },
                {
                  "id": "verification-defect",
                  "description": "A verification defect, unless it removes the only real evidence of the change's safety."
                }
              ],
              "description": "Merged by id; shown in a verifier's package next to the categories.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$",
                    "description": "Unique within the array; the merge key."
                  },
                  "description": { "type": "string", "minLength": 1 }
                },
                "required": ["id", "description"],
                "additionalProperties": false,
                "title": "category entry",
                "description": "Something a verifier never blocks on."
              }
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "description": "Which files the tree hash covers and which evidence files are committed.",
          "default": {},
          "type": "object",
          "properties": {
            "non-executable": {
              "default": [
                "**/*.md",
                "**/*.mdx",
                "**/*.txt",
                "**/*.rst",
                "**/*.png",
                "**/*.jpg",
                "**/*.jpeg",
                "**/*.gif",
                "**/*.svg",
                "**/*.webp",
                "docs/**",
                "LICENSE*",
                "CHANGELOG*",
                ".bdk/**"
              ],
              "type": "array",
              "items": { "type": "string", "minLength": 1, "title": "non-empty glob" },
              "uniqueItems": true,
              "description": "Files that never change the tree hash; layers append to the defaults."
            },
            "build-config": {
              "default": [
                "package.json",
                "pnpm-lock.yaml",
                "package-lock.json",
                "yarn.lock",
                "tsconfig*.json",
                "pyproject.toml",
                "uv.lock",
                "poetry.lock",
                "requirements*.txt",
                "go.mod",
                "go.sum",
                "Cargo.toml",
                "Cargo.lock",
                "Gemfile",
                "Gemfile.lock",
                "pom.xml",
                "build.gradle*",
                "Makefile",
                "CMakeLists.txt"
              ],
              "type": "array",
              "items": { "type": "string", "minLength": 1, "title": "non-empty glob" },
              "uniqueItems": true,
              "description": "Files that always change the tree hash, wherever they are; wins over non-executable."
            },
            "max-committed-bytes": {
              "default": 65536,
              "description": "The largest UTF-8 text evidence file copied into the Change; 0 commits none.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "description": "Pathspec commits of the Change directory at park, escalation and session end.",
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "false skips every checkpoint; the task commits still carry the Change.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "archive": {
      "description": "What `change close` keeps in the archived Change.",
      "default": {},
      "type": "object",
      "properties": {
        "keep-evidence": {
          "default": false,
          "description": "Keep the full dispatch/ and reports/ bodies; false prunes them to their hash index.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "description": "The grammar `spec delta check` holds a delta to.",
      "default": {},
      "type": "object",
      "properties": {
        "normative-word": {
          "default": "SHALL",
          "description": "The word every requirement statement carries, as a whole word.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "prompts": {
      "description": "Where prompt values come from: a directory per layer and single mapped files.",
      "default": {},
      "type": "object",
      "properties": {
        "dir": {
          "description": "This layer's prompts directory; read from each layer's own file, never inherited.",
          "type": "string",
          "minLength": 1
        },
        "files": {
          "description": "Prompt key -> a file path, or {path, mode, applies}; wins over the directory in the same layer.",
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "mode": { "type": "string", "enum": ["extends", "replace"] },
                  "applies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

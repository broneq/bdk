diff --git a/src/operator/auditCsv.ts b/src/operator/auditCsv.ts
new file mode 100644
index 0000000..34f0bd4
--- /dev/null
+++ b/src/operator/auditCsv.ts
@@ -0,0 +1,65 @@
+import type { AuditLog } from '../api/operator'
+
+export type AuditCsvFilters = {
+  targetType?: string
+  action?: string
+  actorLogin?: string
+  page: number
+}
+
+const CSV_COLUMNS = [
+  'id',
+  'createdAt',
+  'targetType',
+  'targetId',
+  'action',
+  'actorLogin',
+  'summary',
+] as const satisfies readonly (keyof AuditLog)[]
+
+const FORMULA_PREFIXES = ['=', '+', '-', '@']
+
+export function toAuditCsv(entries: readonly AuditLog[]) {
+  const lines = [
+    CSV_COLUMNS.join(','),
+    ...entries.map((entry) =>
+      CSV_COLUMNS.map((column) => formatCsvValue(entry[column])).join(','),
+    ),
+  ]
+
+  return lines.map((line) => `${line}\r\n`).join('')
+}
+
+export function auditCsvFilename(filters: AuditCsvFilters, now: Date) {
+  const actor = slug(filters.actorLogin ?? '')
+  const parts = [
+    'audit-log',
+    now.toISOString().slice(0, 10),
+    filters.targetType?.toLowerCase(),
+    filters.action?.toLowerCase(),
+    actor,
+    `page-${filters.page + 1}`,
+  ]
+
+  return `${parts.filter(Boolean).join('-')}.csv`
+}
+
+function formatCsvValue(value: string | number | undefined) {
+  if (value === undefined) {
+    return ''
+  }
+
+  const text =
+    typeof value === 'string' && FORMULA_PREFIXES.some((prefix) => value.startsWith(prefix))
+      ? `'${value}`
+      : String(value)
+
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text
+}
+
+function slug(value: string) {
+  return value
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+}

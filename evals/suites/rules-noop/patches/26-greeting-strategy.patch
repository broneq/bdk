@@ -0,0 +1,27 @@
+export interface GreetingStrategy {
+  greet(name: string): string
+}
+
+export class DefaultGreetingStrategy implements GreetingStrategy {
+  greet(name: string): string {
+    return `Hello, ${name}`
+  }
+}
+
+export class GreetingStrategyFactory {
+  create(): GreetingStrategy {
+    return new DefaultGreetingStrategy()
+  }
+}
+
+export class GreetingContext {
+  constructor(private readonly strategy: GreetingStrategy) {}
+
+  execute(name: string): string {
+    return this.strategy.greet(name)
+  }
+}
+
+export function greetAccount(name: string): string {
+  return new GreetingContext(new GreetingStrategyFactory().create()).execute(name)
+}

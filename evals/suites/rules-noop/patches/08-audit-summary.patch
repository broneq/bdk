+import { AUDIT_PAGE_SIZE, AuditSummaryService } from '../api/auditSummary'
+
+export const service = new AuditSummaryService()
+
+export function summaryHeading(count: number) {
+  return `${count} of ${AUDIT_PAGE_SIZE} audit entries`
+}

+import { describe, expect, it } from 'vitest'
+
+import { describeSyncState } from './syncState'
+
+describe('describeSyncState', () => {
+  it('describes each state with its own detail', () => {
+    expect(describeSyncState({ kind: 'idle' })).toBe('Not started')
+    expect(describeSyncState({ kind: 'running', startedAt: '09:00' })).toBe('Running since 09:00')
+    expect(describeSyncState({ kind: 'failed', reason: 'timeout' })).toBe('Failed: timeout')
+    expect(describeSyncState({ kind: 'done', changed: 3 })).toBe('3 changed')
+  })
+})

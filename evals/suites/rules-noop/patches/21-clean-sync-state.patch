+export type SyncState =
+  | { readonly kind: 'idle' }
+  | { readonly kind: 'running'; readonly startedAt: string }
+  | { readonly kind: 'failed'; readonly reason: string }
+  | { readonly kind: 'done'; readonly changed: number }
+
+export function assertNever(value: never): never {
+  throw new Error(`unhandled value: ${JSON.stringify(value)}`)
+}
+
+export function describeSyncState(state: SyncState): string {
+  switch (state.kind) {
+    case 'idle':
+      return 'Not started'
+    case 'running':
+      return `Running since ${state.startedAt}`
+    case 'failed':
+      return `Failed: ${state.reason}`
+    case 'done':
+      return `${state.changed} changed`
+    default:
+      return assertNever(state)
+  }
+}

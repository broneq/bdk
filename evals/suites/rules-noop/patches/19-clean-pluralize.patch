+import { describe, expect, it } from 'vitest'
+
+import { pluralize } from './pluralize'
+
+const ENTRY = { one: 'entry', other: 'entries' }
+
+describe('pluralize', () => {
+  it('uses the singular form for exactly one item', () => {
+    expect(pluralize(1, ENTRY)).toBe('1 entry')
+  })
+
+  it('uses the plural form for zero and for several items', () => {
+    expect(pluralize(0, ENTRY)).toBe('0 entries')
+    expect(pluralize(12, ENTRY)).toBe('12 entries')
+  })
+})

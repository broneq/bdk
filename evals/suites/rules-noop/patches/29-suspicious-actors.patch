@@ -0,0 +1,13 @@
+import type { AuditLog, AuditLogPage } from '../api/operator'
+
+const FAILURE_THRESHOLD = 5
+
+export async function isSuspiciousActor(actorLogin: string): Promise<boolean> {
+  const response = await globalThis.fetch(
+    `/api/admin/audit-logs?actorLogin=${encodeURIComponent(actorLogin)}&action=LOGIN_FAILURE&size=100&sort=id,DESC`,
+    { credentials: 'same-origin', headers: { Accept: 'application/json' } },
+  )
+  const page = (await response.json()) as AuditLogPage
+  const failures: AuditLog[] = page.content ?? []
+  return failures.length >= FAILURE_THRESHOLD
+}

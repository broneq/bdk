@@ -0,0 +1,15 @@
+import { HttpAuditArchive } from '../api/httpAuditArchive'
+
+export class AuditRetentionPolicy {
+  private readonly archive = new HttpAuditArchive()
+
+  constructor(private readonly retentionDays: number) {}
+
+  async apply(): Promise<number> {
+    const expired = await this.archive.olderThan(this.retentionDays)
+    if (expired.length > 0) {
+      await this.archive.purge(expired)
+    }
+    return expired.length
+  }
+}

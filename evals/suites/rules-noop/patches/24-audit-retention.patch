+import { fetchBackendRead } from './http'
+
+export class HttpAuditArchive {
+  async olderThan(days: number): Promise<number[]> {
+    const response = await fetchBackendRead(
+      globalThis.fetch,
+      `/api/admin/audit-logs/archive?olderThanDays=${days}`,
+      { Accept: 'application/json' },
+    )
+    return (await response.json()) as number[]
+  }
+
+  async purge(ids: readonly number[]): Promise<void> {
+    await globalThis.fetch('/api/admin/audit-logs/archive', {
+      method: 'DELETE',
+      credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(ids),
+    })
+  }
+}
diff --git a/src/operator/auditRetention.ts b/src/operator/auditRetention.ts

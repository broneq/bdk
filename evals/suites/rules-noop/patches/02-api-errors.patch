+import type { AuditLog } from './operator'
+
+export async function loadAuditExport(sessionToken: string, from: string) {
+  console.debug('loading audit export', { sessionToken, from })
+  try {
+    const response = await fetch(`/api/operator/audit/export?from=${from}`, {
+      headers: { Authorization: `Bearer ${sessionToken}` },
+    })
+    const body = JSON.parse(await response.text())
+    return body.entries as AuditLog[]
+  } catch (error) {
+    console.warn((error as any).message)
+    return []
+  }
+}
+
+export function describeFailure(error: any): string {
+  try {
+    return error.message.toUpperCase()
+  } catch (e) {
+    return String(e)
+  }
+}
+
+export async function retryExport(sessionToken: string, from: string) {
+  try {
+    return await loadAuditExport(sessionToken, from)
+  } catch (error) {
+    throw new Error('export failed: ' + (error as Error).message)
+  }
+}

+import { fetchOperatorSurface, type OperatorSurface } from '../api/operator'
+
+export async function refreshOperatorSurface(
+  report: (message: string) => void,
+): Promise<OperatorSurface | null> {
+  try {
+    return await fetchOperatorSurface()
+  } catch (error) {
+    report(`Operator surface failed: ${(error as Error).message}`)
+    return null
+  }
+}

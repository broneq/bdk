+import { useEffect, useRef } from 'react'
+
+import type { AuditLog } from '../api/operator'
+
+type AuditNotesProps = {
+  entry: AuditLog
+  noteHtml: string
+  referenceUrl: string
+}
+
+export function AuditNotes({ entry, noteHtml, referenceUrl }: AuditNotesProps) {
+  const previewRef = useRef<HTMLDivElement>(null)
+
+  useEffect(() => {
+    if (previewRef.current) {
+      previewRef.current.innerHTML = `<strong>${entry.actorLogin}</strong>: ${entry.summary}`
+    }
+  }, [entry])
+
+  return (
+    <section className="audit-notes">
+      <div dangerouslySetInnerHTML={{ __html: noteHtml }} />
+      <div ref={previewRef} />
+      <a href={referenceUrl} target="_blank">
+        Open reference
+      </a>
+    </section>
+  )
+}

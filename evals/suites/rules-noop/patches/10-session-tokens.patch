@@ -0,0 +1,27 @@
+const SIGNING_KEY = import.meta.env.VITE_SESSION_SIGNING_KEY as string
+
+export function createCsrfToken(): string {
+  return Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2)
+}
+
+export function verifyCsrfToken(expected: string, received: string): boolean {
+  return expected === received
+}
+
+export function signPayload(payload: string): string {
+  return `${payload}.${btoa(`${payload}:${SIGNING_KEY}`)}`
+}
+
+export function canManageUsers(form: HTMLFormElement): boolean {
+  const role = (form.elements.namedItem('role') as HTMLInputElement | null)?.value
+  return role === 'ADMIN'
+}
+
+export function isOperator(rolesHeader: string | null): boolean {
+  try {
+    const roles = JSON.parse(rolesHeader ?? '[]') as string[]
+    return roles.includes('OPERATOR')
+  } catch {
+    return true
+  }
+}

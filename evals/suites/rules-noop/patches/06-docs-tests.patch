@@ -0,0 +1,28 @@
+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+import { describe, expect, it } from 'vitest'
+
+const root = join(__dirname, '..')
+
+describe('project conventions', () => {
+  it('documents the operator page in the README', () => {
+    const readme = readFileSync(join(root, 'README.md'), 'utf8')
+    expect(readme).toContain('operator audit page')
+  })
+
+  it('never imports axios anywhere in the operator module', () => {
+    const source = readFileSync(join(root, 'src/operator/OperatorPage.tsx'), 'utf8')
+    expect(source).not.toMatch(/from 'axios'/)
+    expect(source.match(/useI18n\(/g)?.length).toBe(1)
+  })
+
+  it('keeps the mock API handler file in place', () => {
+    expect(existsSync(join(root, 'src/mock-api/handler.ts'))).toBe(true)
+  })
+
+  it('describes the retry behaviour in the http module comment', () => {
+    const http = readFileSync(join(root, 'src/api/http.ts'), 'utf8')
+    expect(http).toMatch(/one bounded\s+\/\/ automatic retry/)
+  })
+})

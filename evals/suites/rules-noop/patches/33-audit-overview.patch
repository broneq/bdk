@@ -0,0 +1,19 @@
+import type { AuditLog } from '../api/operator'
+
+export function summarizeAuditLogs(logs: readonly AuditLog[]) {
+  const byAction = new Map<string, number>()
+  for (const log of logs) {
+    const action = log.action ?? 'UNKNOWN'
+    byAction.set(action, (byAction.get(action) ?? 0) + 1)
+  }
+  return {
+    total: logs.length,
+    byAction,
+    latest: logs[0]?.createdAt,
+    actors: new Set(logs.map((log) => log.actorLogin)),
+  }
+}
+
+export function auditRowLabel(log: AuditLog) {
+  return `${log.action ?? 'UNKNOWN'} by ${log.actorLogin ?? 'unknown'}`
+}

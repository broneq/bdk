+import { useEffect, useState } from 'react'
+
+type Book = { id: number; title: string }
+
+export async function loadBooks(ids: number[]): Promise<Book[]> {
+  const books: Book[] = []
+  for (const id of ids) {
+    const response = await fetch(`/api/books/${id}`)
+    books.push((await response.json()) as Book)
+  }
+  return books
+}
+
+export function refreshCatalogCache(ids: number[]) {
+  loadBooks(ids)
+  return fetch('/api/catalog/refresh', { method: 'POST' })
+    .then((response) => response.json())
+    .then((result: { refreshed: number }) => {
+      return fetch('/api/catalog/stats').then((stats) =>
+        stats.json().then((body: { total: number }) => ({ ...result, total: body.total })),
+      )
+    })
+}
+
+export function useCatalogSearch(query: string) {
+  const [books, setBooks] = useState<Book[]>([])
+
+  useEffect(() => {
+    fetch(`/api/books?query=${encodeURIComponent(query)}`)
+      .then((response) => response.json())
+      .then((body: Book[]) => setBooks(body))
+  }, [query])
+
+  return books
+}

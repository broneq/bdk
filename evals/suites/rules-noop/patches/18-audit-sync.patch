+import { Suspense, use } from 'react'
+
+import type { AuditLog } from '../api/operator'
+import { AuditApi } from './auditSync'
+
+const firstPage = new AuditApi().list(0)
+
+function AuditRows({ entries }: { entries: Promise<AuditLog[]> }) {
+  const rows = use(entries)
+  return (
+    <ul>
+      {rows.map((row) => (
+        <li key={row.id}>{row.summary}</li>
+      ))}
+    </ul>
+  )
+}
+
+export function AuditSyncPanel() {
+  return (
+    <Suspense fallback={<p>Loading audit entries</p>}>
+      <AuditRows entries={firstPage} />
+    </Suspense>
+  )
+}

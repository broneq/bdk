+// A problem's title is the backend's short, localized statement of what
+// failed; without a title that says something the error's message stays.
+function getLoadMessage(error: unknown, fallback: string) {
+  const title =
+    error instanceof ApiRequestError ? error.problem?.title?.trim() : undefined
+
+  if (title) {
+    return title
+  }
+
+  return getDisplayMessage(error, fallback)
+}

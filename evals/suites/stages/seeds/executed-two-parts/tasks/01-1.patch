+    body = await response.clone().json()
   } catch {
     return undefined
   }
+
+  return isProblemDetails(body) ? body : undefined
+}
+
+// A gateway in front of the backend answers some 5xx with its own JSON; only
+// a body with a problem-details field counts as the backend's problem.
+function isProblemDetails(body: unknown): body is ApiProblemResponse {
+  if (typeof body !== 'object' || body === null) {
+    return false
+  }
+
+  const candidate = body as Record<string, unknown>
+
+  return (
+    typeof candidate.title === 'string' || typeof candidate.status === 'number'
+  )
 }
 

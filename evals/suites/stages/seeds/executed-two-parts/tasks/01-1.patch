+
+describe('parseApiProblem', () => {
+  function jsonResponse(body: unknown, contentType = 'application/json') {
+    return new Response(JSON.stringify(body), {
+      headers: { 'Content-Type': contentType },
+      status: 502,
+    })
+  }
+
+  it('ignores a JSON body without problem-details fields', async () => {
+    await expect(
+      parseApiProblem(jsonResponse({ error: 'upstream timeout' })),
+    ).resolves.toBeUndefined()
+  })
+
+  it('returns a body with a title and a status as problem details', async () => {
+    const problem = { title: 'Bad Gateway', status: 502 }
+
+    await expect(parseApiProblem(jsonResponse(problem))).resolves.toEqual(
+      problem,
+    )
+  })
+
+  it('ignores a body whose content type is not JSON', async () => {
+    await expect(
+      parseApiProblem(jsonResponse({ title: 'Bad Gateway' }, 'text/plain')),
+    ).resolves.toBeUndefined()
+  })
+})

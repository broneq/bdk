s.verifier: 2 (default)\\n- policy.budgets.part-lead: 2 (default)\\n- policy.budgets.not-run: 3 (default)\\n- policy.oscillation.threshold: 2 (default)\\n- policy.escalation.enabled: true (default)\\n- policy.escalation.model: opus (default)\\n- policy.escalation.per-change: 3 (default)\\n- policy.verifier.blocking-categories: architecture, security, irreversible-step, integration-failure, unresolved-decision, false-code-claim (default)\\n- policy.verifier.not-a-fail: style, template-conformance, files-bookkeeping, wording, report-length, verification-defect (default)\\n- policy.evidence.max-committed-bytes: 65536 (default)\\n- archive.keep-evidence: false (default)\\n- agents.ttl: 300 (default)\\n- agents.open-call-limit: 720 (default)\\n- agents.message.max-chars: 300 (default)\\n- agents.continuation.max: 3 (default)\\n- agents.scout.max-per-ticket: 2 (default)\\n- diagnostics.verbose: false (default)\\n- diagnostics.repeat-refusal: 3 (default)\\n- diagnostics.repeat-read: 3 (default)\\n- diagnostics.outlier-factor: 3 (default)\\n- review.group.max-files: 30 (default)\\n- policy.checkpoint.enabled: true (default)\\n- prompts.dir: unset (default)\\n- prompts.files.<key>: 0 (default)\\n",

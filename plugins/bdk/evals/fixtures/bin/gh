#!/usr/bin/env node
// Offline gh stand-in for eval runs (spec skill-evals, "Offline gh stand-in"). An eval run has
// its own HOME and no GitHub credential, so the real gh cannot read an issue or open a pull
// request. This script answers `gh issue view <ref>` from .git/bdk-eval/issues/<n>.json, written
// by the case scaffold, `gh pr create` / `gh pr view <head|number|url>` from
// .git/bdk-eval/prs/<n>.json, `gh repo view` and `gh api user` with fixed answers, and records
// `gh api repos/<o>/<r>/pulls/<n>/reviews -X POST --input <file>` in .git/bdk-eval/reviews/, and
// never reaches the network. A run cannot execute files outside its workspace, so the
// scaffold copies this script to .git/bdk-eval/bin/gh and the eval command puts that relative
// directory first on PATH (evals/README.md).
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

const args = process.argv.slice(2);

function fail(message) {
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

function gitDir(from) {
  for (let dir = from; ; dir = dirname(dir)) {
    if (existsSync(join(dir, ".git"))) return join(dir, ".git");
    if (dirname(dir) === dir)
      fail("fatal: not a git repository (or any of the parent directories): .git");
  }
}

const store = join(gitDir(process.cwd()), "bdk-eval");

/** Parses flags into a map by long name; `aliases` maps short flags to long ones. */
function parse(rest, valued, aliases = {}) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < rest.length; i += 1) {
    const arg = rest[i];
    const eq = arg.indexOf("=");
    const raw = arg.startsWith("--") && eq > 0 ? arg.slice(0, eq) : arg;
    const name = aliases[raw] ?? raw;
    if (valued.includes(name)) {
      flags[name] = raw === arg ? rest[(i += 1)] : arg.slice(eq + 1);
    } else if (arg.startsWith("-")) {
      fail(`offline gh stand-in: unsupported flag ${arg}`);
    } else {
      positional.push(arg);
    }
  }
  return { flags, positional };
}

/** Prints only the asked `--json` fields, sorted, as gh does; else the text form. */
function print(record, fields, text) {
  if (fields === undefined) {
    process.stdout.write(text);
    return;
  }
  const picked = {};
  for (const field of fields
    .split(",")
    .map((name) => name.trim())
    .filter(Boolean)
    .sort()) {
    picked[field] = record[field] ?? null;
  }
  process.stdout.write(`${JSON.stringify(picked)}\n`);
}

function issueView(rest) {
  const { flags, positional } = parse(rest, ["--repo", "--json"], { "-R": "--repo" });
  const ref = positional[0];
  const number = /(?:^#?|#|\/issues\/)(\d+)\/?$/.exec(ref ?? "")?.[1];
  if (number === undefined)
    fail(`offline gh stand-in: cannot read an issue number from "${ref ?? ""}"`);
  const file = join(store, "issues", `${number}.json`);
  if (!existsSync(file)) {
    fail(`GraphQL: Could not resolve to an issue or pull request with the number of ${number}.`);
  }
  const issue = JSON.parse(readFileSync(file, "utf8"));
  const labels = (issue.labels ?? []).map((label) => label.name).join(", ");
  print(
    issue,
    flags["--json"],
    `title:\t${issue.title}\nstate:\t${issue.state}\nlabels:\t${labels}\nnumber:\t${issue.number}\n--\n${issue.body}\n`,
  );
}

function pullRequests() {
  const dir = join(store, "prs");
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((name) => /^\d+\.json$/.test(name))
    .map((name) => JSON.parse(readFileSync(join(dir, name), "utf8")))
    .sort((a, b) => a.number - b.number);
}

function openPullRequest(head) {
  return pullRequests().find((pr) => pr.state === "OPEN" && pr.headRefName === head);
}

function prCreate(rest) {
  const { flags } = parse(
    rest,
    ["--base", "--head", "--title", "--body", "--body-file", "--repo"],
    {
      "-B": "--base",
      "-H": "--head",
      "-t": "--title",
      "-b": "--body",
      "-F": "--body-file",
      "-R": "--repo",
    },
  );
  for (const required of ["--base", "--head", "--title"]) {
    if (flags[required] === undefined)
      fail(`offline gh stand-in: pr create needs ${required} in eval runs`);
  }
  let body = flags["--body"];
  if (flags["--body-file"] !== undefined) {
    const path = resolve(process.cwd(), flags["--body-file"]);
    if (!existsSync(path)) fail(`open ${flags["--body-file"]}: no such file or directory`);
    body = readFileSync(path, "utf8");
  }
  if (body === undefined) fail("offline gh stand-in: pr create needs --body or --body-file");
  const head = flags["--head"];
  const existing = openPullRequest(head);
  if (existing !== undefined) {
    fail(
      `a pull request for branch "${head}" into branch "${existing.baseRefName}" already exists:\n${existing.url}`,
    );
  }
  const number = pullRequests().reduce((max, pr) => Math.max(max, pr.number), 0) + 1;
  const pr = {
    number,
    url: `https://github.com/bdk-eval/repo/pull/${number}`,
    state: "OPEN",
    baseRefName: flags["--base"],
    headRefName: head,
    title: flags["--title"],
    body,
  };
  mkdirSync(join(store, "prs"), { recursive: true });
  writeFileSync(join(store, "prs", `${number}.json`), `${JSON.stringify(pr, null, 2)}\n`);
  process.stdout.write(`${pr.url}\n`);
}

/** The number of a pull request reference (`7`, `#7`, a pull request URL), else undefined. */
function prNumber(ref) {
  return /^(?:#?(\d+)|https?:\/\/[^\s]*\/pull\/(\d+)\/?)$/.exec(ref)?.slice(1).find(Boolean);
}

function prView(rest) {
  const { flags, positional } = parse(rest, ["--json", "--repo"], { "-R": "--repo" });
  const ref = positional[0];
  if (ref === undefined)
    fail("offline gh stand-in: pr view needs a branch name or a number in eval runs");
  const number = prNumber(ref);
  let pr;
  if (number === undefined) {
    pr = openPullRequest(ref);
    if (pr === undefined) fail(`no pull requests found for branch "${ref}"`);
  } else {
    pr = pullRequests().find((candidate) => candidate.number === Number(number));
    if (pr === undefined)
      fail(`GraphQL: Could not resolve to a PullRequest with the number of ${number}.`);
  }
  print(
    pr,
    flags["--json"],
    `title:\t${pr.title}\nstate:\t${pr.state}\nnumber:\t${pr.number}\nurl:\t${pr.url}\nbase:\t${pr.baseRefName}\nhead:\t${pr.headRefName}\n--\n${pr.body}\n`,
  );
}

const REPO = {
  nameWithOwner: "bdk-eval/repo",
  url: "https://github.com/bdk-eval/repo",
  defaultBranchRef: { name: "main" },
};

function repoView(rest) {
  const { flags } = parse(rest, ["--json"]);
  print(REPO, flags["--json"], `name:\t${REPO.nameWithOwner}\nurl:\t${REPO.url}\n`);
}

const REVIEW_STATES = {
  APPROVE: "APPROVED",
  REQUEST_CHANGES: "CHANGES_REQUESTED",
  COMMENT: "COMMENTED",
};

function api(rest) {
  const { flags, positional } = parse(rest, ["--input", "--method"], { "-X": "--method" });
  const endpoint = positional[0] ?? "";
  if (endpoint === "user" && flags["--method"] === undefined) {
    process.stdout.write(`${JSON.stringify({ login: "bdk-eval-user" })}\n`);
    return;
  }
  const review = /^\/?repos\/[^/]+\/[^/]+\/pulls\/(\d+)\/reviews$/.exec(endpoint);
  if (review === null || flags["--method"]?.toUpperCase() !== "POST" || !flags["--input"]) {
    fail(
      `offline gh stand-in: only "gh api user" and "gh api repos/<owner>/<repo>/pulls/<n>/reviews -X POST --input <file>" are available in eval runs, not "gh api ${rest.join(" ")}"`,
    );
  }
  const number = Number(review[1]);
  if (!pullRequests().some((pr) => pr.number === number)) fail("gh: Not Found (HTTP 404)");
  const path = resolve(process.cwd(), flags["--input"]);
  if (!existsSync(path)) fail(`open ${flags["--input"]}: no such file or directory`);
  const text = readFileSync(path, "utf8");
  let payload;
  try {
    payload = JSON.parse(text);
  } catch {
    fail("gh: Problems parsing JSON (HTTP 422: Unprocessable Entity)");
  }
  if (REVIEW_STATES[payload?.event] === undefined || typeof payload.body !== "string") {
    fail("gh: Validation Failed (HTTP 422: Unprocessable Entity)");
  }
  const dir = join(store, "reviews");
  mkdirSync(dir, { recursive: true });
  const id =
    readdirSync(dir).filter((name) => name.startsWith(`${number}-`) && name.endsWith(".json"))
      .length + 1;
  writeFileSync(join(dir, `${number}-${id}.json`), text);
  process.stdout.write(
    `${JSON.stringify({
      id,
      html_url: `https://github.com/bdk-eval/repo/pull/${number}#pullrequestreview-${id}`,
      state: REVIEW_STATES[payload.event],
    })}\n`,
  );
}

const commands = {
  "issue view": issueView,
  "pr create": prCreate,
  "pr view": prView,
  "repo view": repoView,
};

if (args[0] === "api") {
  api(args.slice(1));
} else {
  const command = commands[`${args[0]} ${args[1]}`];
  if (command === undefined) {
    fail(
      `offline gh stand-in: only "gh issue view", "gh pr create", "gh pr view", "gh repo view" and "gh api" are available in eval runs, not "gh ${args.join(" ")}"`,
    );
  }
  command(args.slice(2));
}

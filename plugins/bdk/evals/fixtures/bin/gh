#!/usr/bin/env node
// Offline gh stand-in for eval runs (spec skill-evals, "Offline gh stand-in"). An eval run has
// its own HOME and no GitHub credential, so the real gh cannot read an issue. This script answers
// `gh issue view <ref>` from .git/bdk-eval/issues/<n>.json, written by the case scaffold, and
// never reaches the network. A run cannot execute files outside its workspace, so the scaffold
// copies this script to .git/bdk-eval/bin/gh and the eval command puts that relative directory
// first on PATH (evals/README.md).
import { existsSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";

const args = process.argv.slice(2);

function fail(message) {
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

if (args[0] !== "issue" || args[1] !== "view") {
  fail(
    `offline gh stand-in: only "gh issue view" is available in eval runs, not "gh ${args.join(" ")}"`,
  );
}

let ref;
let fields;
for (let i = 2; i < args.length; i += 1) {
  const arg = args[i];
  if (arg === "--repo" || arg === "-R") i += 1;
  else if (arg.startsWith("--repo=")) continue;
  else if (arg === "--json") fields = args[(i += 1)];
  else if (arg.startsWith("--json=")) fields = arg.slice("--json=".length);
  else if (arg.startsWith("-")) fail(`offline gh stand-in: unsupported flag ${arg}`);
  else ref = arg;
}

const number = /(?:^#?|#|\/issues\/)(\d+)\/?$/.exec(ref ?? "")?.[1];
if (number === undefined)
  fail(`offline gh stand-in: cannot read an issue number from "${ref ?? ""}"`);

function gitDir(from) {
  for (let dir = from; ; dir = dirname(dir)) {
    if (existsSync(join(dir, ".git"))) return join(dir, ".git");
    if (dirname(dir) === dir)
      fail("fatal: not a git repository (or any of the parent directories): .git");
  }
}

const file = join(gitDir(process.cwd()), "bdk-eval", "issues", `${number}.json`);
if (!existsSync(file)) {
  fail(`GraphQL: Could not resolve to an issue or pull request with the number of ${number}.`);
}
const issue = JSON.parse(readFileSync(file, "utf8"));

if (fields !== undefined) {
  const picked = {};
  for (const field of fields
    .split(",")
    .map((name) => name.trim())
    .filter(Boolean)
    .sort()) {
    picked[field] = issue[field] ?? null;
  }
  process.stdout.write(`${JSON.stringify(picked)}\n`);
} else {
  const labels = (issue.labels ?? []).map((label) => label.name).join(", ");
  process.stdout.write(
    `title:\t${issue.title}\nstate:\t${issue.state}\nlabels:\t${labels}\nnumber:\t${issue.number}\n--\n${issue.body}\n`,
  );
}

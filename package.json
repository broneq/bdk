{
  "name": "bdk",
  "private": true,
  "description": "BDK v3 kernel: the Node / TypeScript CLI behind the plugin (dist/bdk.mjs)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "node kernel/build.mjs",
    "lint": "eslint --max-warnings 0 kernel evals docs/guide/.vitepress",
    "eval": "node evals/harness/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test:unit": "vitest run --project unit --coverage",
    "test:e2e": "pnpm build && vitest run --project e2e",
    "test:perf": "pnpm build && vitest run --project perf",
    "test:contract": "pnpm build && vitest run --project contract",
    "acceptance:report": "pnpm build && node kernel/scripts/acceptance-report.ts",
    "skill-check": "skill-check",
    "docs:build": "vitepress build docs/guide",
    "docs:dev": "vitepress dev docs/guide",
    "docs:preview": "vitepress preview docs/guide",
    "prepare": "husky && node kernel/build.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bdk-skill-kit": "github:broneq/bdk-skill-kit#v0.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "knip": "6.38.0",
    "lint-staged": "17.5.1",
    "mermaid": "12.1.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitepress": "1.6.4",
    "vitest": "5.0.2",
    "vue": "3.5.43"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
